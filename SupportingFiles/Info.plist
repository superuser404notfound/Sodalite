<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- One key, and it has to stay alone. NSAllowsArbitraryLoads is IGNORED the moment any of
	     NSAllowsLocalNetworking / NSAllowsArbitraryLoadsInWebContent / NSAllowsArbitraryLoadsInMedia
	     sits beside it (iOS and tvOS 10 and later), and the plain default takes over instead:
	     cleartext to the local network only. Measured on tvOS 26.5 on 2026-08-30, http to a public
	     address failed with NSURLErrorDomain -1022 in 0.0s ("does not conform to ATS policy") while
	     the same request to a private address went out and timed out on the wire like any other.
	     A self-hosted Jellyfin reachable at a public address over plain http is an ordinary setup,
	     and the pair locked those users out of setup entirely with "Server unreachable", since the
	     -1022 folds into .serverUnreachable in DiscoveryProbeRace. Putting NSAllowsLocalNetworking
	     back re-breaks them: the permissive key is the one that covers the LAN too. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sodalite reaches Jellyfin and AetherEngine media servers on your local network. Required for direct play of media from a server in your home.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Shared by both app targets; this file wins over any INFOPLIST_KEY_UIBackgroundModes.
	     audio: tvOS otherwise kills the audio session on backgrounding and pauses playback
	     the moment the user leaves the app, even with a live PiP window.
	     remote-notification: CKSyncEngine receives remote changes through silent CloudKit
	     pushes; without this mode they are never delivered and cloud sync only ever fetches
	     when the app foregrounds. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>de.superuser404.Sodalite.pendingRequestsRefresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.superuser404.Sodalite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sodalite</string>
			</array>
		</dict>
	</array>
	<!-- Sodalite#115: without this the Game Controller framework MERGES the physical Apple TV remote
	     with the virtual one from an iPhone's Control Center into a single device whose
	     productCategory reads "Coalesced Remote", and the real remote's own category disappears.
	     Measured on the living room Apple TV on 2026-09-05: opening the iPhone remote replaced
	     "Siri Remote (2nd Generation)" with "Coalesced Remote" for as long as it stayed open.
	     SiriRemoteSurfaceTracker gates the edge-click seek on the 1st-generation category, so
	     coalescing would silently switch the feature off for anyone whose household has that widget
	     up. Apple recommends the key for correct 2021-remote support as well (GCDirectionalGamepad.h).
	     Inert on iOS, where there is no remote to coalesce; this file is shared by both app targets. -->
	<key>GCSupportsMultipleMicroGamepads</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>AtkinsonHyperlegible-Regular.ttf</string>
		<string>AtkinsonHyperlegible-Italic.ttf</string>
		<string>AtkinsonHyperlegible-Bold.ttf</string>
		<string>AtkinsonHyperlegible-BoldItalic.ttf</string>
	</array>
</dict>
</plist>
