    "changelog.0_4_1.endOfContent.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávač vás po skončení filmu nebo poslední epizody seriálu automaticky vrátí na detail."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilleren returnerer dig til detaljevisningen når en film eller seriens sidste afsnit slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Film oder die letzte Folge einer Serie endet, schließt der Player automatisch zurück zur Detailansicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν τελειώνει μια ταινία ή το τελευταίο επεισόδιο, το πρόγραμμα αναπαραγωγής σας επιστρέφει αυτόματα στις λεπτομέρειες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Player returns you to the detail view when a movie or the last episode of a series ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reproductor te devuelve a la vista de detalle cuando termina una película o el último episodio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soitin palauttaa sinut tietonäkymään, kun elokuva tai sarjan viimeinen jakso päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur vous ramène à la vue détail à la fin d'un film ou du dernier épisode d'une série."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduktor vas vraća na pregled detalja kad film ili posljednja epizoda serije završi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszó visszavisz a részletek nézetbe, ha egy film vagy a sorozat utolsó epizódja véget ér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il player ti riporta alla schermata dettagli quando un film o l'ultimo episodio finisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やシリーズの最終話が終わると、プレーヤーは自動的に詳細画面に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화나 시리즈의 마지막 에피소드가 끝나면 플레이어가 자동으로 상세 화면으로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spilleren returnerer deg til detaljvisningen når en film eller seriens siste episode slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De speler keert terug naar de detailweergave wanneer een film of laatste aflevering eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzacz wraca do widoku szczegółów po zakończeniu filmu lub ostatniego odcinka serialu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O player retorna à tela de detalhes quando um filme ou o último episódio termina."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reprodutor regressa ao ecrã de detalhes quando um filme ou o último episódio termina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playerul te returnează la vizualizarea detaliilor când un film sau ultimul episod se termină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плеер возвращает вас к экрану деталей по окончании фильма или последней серии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehrávač vás vráti späť na detail po skončení filmu alebo poslednej epizódy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelaren returnerar dig till detaljvyn när en film eller seriens sista avsnitt slutar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir film veya dizinin son bölümü bittiğinde oynatıcı sizi otomatik olarak detay ekranına döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програвач повертає вас до перегляду деталей по завершенні фільму чи останнього епізоду серіалу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
