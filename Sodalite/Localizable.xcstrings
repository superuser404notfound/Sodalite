    "player.error.dolbyVision.body" : {
      "comment" : "Error body when the device cannot decode the source's Dolby Vision profile",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení neumí dekódovat tuto verzi Dolby Vision. Přehraje ji jiná verze souboru nebo zařízení s podporou Dolby Vision."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed kan ikke afkode denne Dolby Vision-version. En anden version af filen, eller en enhed med Dolby Vision-understøttelse, kan afspille den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann diese Dolby-Vision-Fassung nicht dekodieren. Eine andere Fassung der Datei oder ein Gerät mit Dolby-Vision-Unterstützung spielt sie ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν μπορεί να αποκωδικοποιήσει αυτή την έκδοση Dolby Vision. Θα την αναπαραγάγει μια άλλη έκδοση του αρχείου ή μια συσκευή με υποστήριξη Dolby Vision."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device cannot decode this Dolby Vision version. A different version of the file, or a device with Dolby Vision support, will play it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no puede decodificar esta versión de Dolby Vision. La reproducirá otra versión del archivo o un dispositivo compatible con Dolby Vision."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite ei osaa purkaa tätä Dolby Vision -versiota. Sen toistaa tiedoston toinen versio tai laite, joka tukee Dolby Visionia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut pas décoder cette version Dolby Vision. Une autre version du fichier, ou un appareil compatible Dolby Vision, la lira."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj ne može dekodirati ovu Dolby Vision verziju. Reproducirat će je druga verzija datoteke ili uređaj s podrškom za Dolby Vision."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz nem tudja dekódolni ezt a Dolby Vision változatot. A fájl másik változata vagy egy Dolby Vision támogatással rendelkező eszköz lejátssza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può decodificare questa versione Dolby Vision. La riprodurrà un'altra versione del file o un dispositivo con supporto Dolby Vision."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはこの Dolby Vision バージョンをデコードできません。ファイルの別バージョン、または Dolby Vision に対応したデバイスであれば再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 이 Dolby Vision 버전을 디코딩할 수 없습니다. 파일의 다른 버전이나 Dolby Vision을 지원하는 기기에서 재생됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten kan ikke dekode denne Dolby Vision-versjonen. En annen versjon av filen, eller en enhet med Dolby Vision-støtte, spiller den av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat kan deze Dolby Vision-versie niet decoderen. Een andere versie van het bestand of een apparaat met Dolby Vision-ondersteuning speelt het wel af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie nie potrafi zdekodować tej wersji Dolby Vision. Odtworzy ją inna wersja pliku lub urządzenie z obsługą Dolby Vision."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue decodificar esta versão de Dolby Vision. Outra versão do arquivo, ou um dispositivo compatível com Dolby Vision, vai reproduzi-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue descodificar esta versão de Dolby Vision. Outra versão do ficheiro, ou um dispositivo compatível com Dolby Vision, irá reproduzi-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv nu poate decoda această versiune Dolby Vision. O va reda altă versiune a fișierului sau un dispozitiv cu suport Dolby Vision."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство не может декодировать эту версию Dolby Vision. Её воспроизведёт другая версия файла или устройство с поддержкой Dolby Vision."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie nedokáže dekódovať túto verziu Dolby Vision. Prehrá ju iná verzia súboru alebo zariadenie s podporou Dolby Vision."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte avkoda den här Dolby Vision-versionen. En annan version av filen, eller en enhet med stöd för Dolby Vision, spelar upp den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz bu Dolby Vision sürümünü çözemiyor. Dosyanın başka bir sürümü veya Dolby Vision destekleyen bir cihaz oynatabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій не може декодувати цю версію Dolby Vision. Її відтворить інша версія файлу або пристрій із підтримкою Dolby Vision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法解码这个 Dolby Vision 版本。文件的其他版本，或支持 Dolby Vision 的设备，可以播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置無法解碼這個 Dolby Vision 版本。檔案的其他版本，或支援 Dolby Vision 的裝置，即可播放。"
          }
        }
      }
    },
