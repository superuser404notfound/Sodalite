        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat die Daten dieses Geräts abgelehnt. Das ist ein Fehler in Sodalite, nicht auf deinem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iCloud απέρριψε τα δεδομένα αυτής της συσκευής. Πρόκειται για σφάλμα του Sodalite, όχι της συσκευής σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
