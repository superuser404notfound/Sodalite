    "changelog.0_4_1.profileGrid.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení profilů zobrazuje všechny zapamatované profily vedle sebe se zelenou značkou na aktivním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilindstillingerne viser hver husket profil side om side med et grønt mærke på den aktive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Profil-Einstellungen zeigen alle gespeicherten Profile nebeneinander, mit grünem Marker am aktiven."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις προφίλ δείχνουν κάθε αποθηκευμένο προφίλ δίπλα-δίπλα, με πράσινο σημάδι στο ενεργό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile settings shows every remembered profile side-by-side, with a green check on the active session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de perfil muestran cada perfil recordado lado a lado, con marca verde en la sesión activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiiliasetukset näyttää kaikki muistetut profiilit rinnakkain ja vihreällä merkillä aktiivisen istunnon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de profil affichent chaque profil mémorisé côte à côte, avec une coche verte sur la session active."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke profila prikazuju sve zapamćene profile jedan do drugog, sa zelenom oznakom na aktivnoj sesiji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilbeállítások minden megjegyzett profilt egymás mellett mutatnak, zöld pipával az aktív munkameneten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni profilo mostrano ogni profilo ricordato affiancato, con segno verde sulla sessione attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール設定で記憶された全プロフィールを横並びに表示し、アクティブなセッションには緑のチェックを付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 설정에서 기억된 모든 프로필을 나란히 표시하며, 활성 세션에 녹색 체크 표시를 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilinnstillingene viser hver husket profil side ved side, med grønt merke på den aktive økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profielinstellingen tonen elk onthouden profiel naast elkaar, met een groen vinkje op de actieve sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia profilu pokazują każdy zapamiętany profil obok siebie, z zielonym znacznikiem na aktywnej sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurações de perfil mostram cada perfil lembrado lado a lado, com marca verde na sessão ativa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As definições de perfil mostram cada perfil lembrado lado a lado, com marca verde na sessão ativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările de profil afișează fiecare profil memorat alăturat, cu bifă verde pe sesiunea activă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки профиля показывают все сохранённые профили в одной сетке с зелёной отметкой на активной сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia profilov zobrazujú každý zapamätaný profil vedľa seba, so zelenou značkou na aktívnej relácii."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilinställningarna visar varje minns profil sida vid sida, med en grön bock på den aktiva sessionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ayarları, her hatırlanan profili yan yana ve aktif oturumda yeşil bir işaretle gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування профілю показують кожен запам'ятований профіль поряд, із зеленою позначкою на активній сесії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "档案设置中将每个记住的档案并排显示,并在当前会话上加绿色对勾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案設定中將每個記住的檔案並排顯示,並在當前工作階段上加綠色勾號。"
          }
        }
      }
    },
