    "changelog.1_0_0.collections.body" : {
      "comment" : "Changelog 1.0.0: film collections detail",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film, který patří do filmové řady, vede přímo ke své kolekci: všechny díly s jejich dostupností a jedna akce pro vyžádání všeho, co v knihovně chybí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En film, der er del af en filmrække, fører direkte til sin samling: alle dele med deres tilgængelighed og én handling til at anmode om alt, der mangler i biblioteket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Film, der zu einer Reihe gehört, führt direkt zu seiner Sammlung: alle Teile mit ihrer Verfügbarkeit, und eine Aktion für alles, was in der Bibliothek fehlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ταινία που ανήκει σε μια σειρά ταινιών οδηγεί απευθείας στη συλλογή της: όλα τα μέρη με τη διαθεσιμότητά τους και μία ενέργεια για να ζητηθούν όσα λείπουν από τη βιβλιοθήκη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A movie that is part of a series of films links straight to its collection: every part with its availability, and one action to request all the ones missing from your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una película que forma parte de una saga lleva directamente a su colección: todas las partes con su disponibilidad y una sola acción para solicitar las que faltan en la biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elokuva, joka kuuluu elokuvasarjaan, johtaa suoraan kokoelmaansa: kaikki osat saatavuuksineen ja yksi toiminto kaikkien kirjastosta puuttuvien pyytämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un film qui fait partie d'une saga mène directement à sa collection : toutes les parties avec leur disponibilité, et une seule action pour demander celles qui manquent à la bibliothèque."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film koji pripada filmskoj seriji vodi izravno do svoje kolekcije: svi dijelovi sa svojom dostupnošću i jedna radnja za traženje svega što nedostaje u biblioteci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy filmsorozathoz tartozó film közvetlenül a gyűjteményéhez vezet: minden rész az elérhetőségével, és egyetlen művelet mindannak kérésére, ami hiányzik a könyvtárból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un film che fa parte di una serie porta direttamente alla sua raccolta: tutte le parti con la loro disponibilità e una sola azione per richiedere quelle che mancano nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリーズ作品の映画から、そのコレクションへ直接移動できます。すべての作品が利用状況とともに並び、ライブラリにないものをまとめてリクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시리즈에 속한 영화에서 해당 컬렉션으로 바로 이동합니다. 모든 작품이 이용 가능 여부와 함께 표시되고, 라이브러리에 없는 작품을 한 번에 요청할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En film som er del av en filmserie, fører rett til samlingen sin: alle delene med tilgjengeligheten sin, og én handling for å be om alt som mangler i biblioteket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een film die deel uitmaakt van een filmreeks leidt direct naar zijn collectie: alle delen met hun beschikbaarheid en één actie om alles aan te vragen wat in de bibliotheek ontbreekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film należący do serii prowadzi prosto do swojej kolekcji: wszystkie części wraz z ich dostępnością i jedna akcja, aby poprosić o wszystko, czego brakuje w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um filme que faz parte de uma série leva direto à sua coleção: todas as partes com sua disponibilidade e uma única ação para solicitar tudo o que falta na biblioteca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um filme que faz parte de uma série leva diretamente à sua coleção: todas as partes com a sua disponibilidade e uma única ação para pedir tudo o que falta na biblioteca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un film care face parte dintr-o serie duce direct la colecția sa: toate părțile cu disponibilitatea lor și o singură acțiune pentru a solicita tot ce lipsește din bibliotecă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фильм, входящий в серию, ведёт прямо к своей коллекции: все части с их доступностью и одно действие, чтобы запросить всё, чего нет в библиотеке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film, ktorý patrí do filmovej série, vedie priamo k svojej kolekcii: všetky časti s ich dostupnosťou a jedna akcia na vyžiadanie všetkého, čo v knižnici chýba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En film som ingår i en filmserie leder direkt till sin samling: alla delar med sin tillgänglighet och en enda åtgärd för att begära allt som saknas i biblioteket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir seriye ait bir film doğrudan koleksiyonuna götürür: tüm filmler kullanılabilirlik durumlarıyla birlikte ve kitaplıkta eksik olanların tümünü istemek için tek bir eylem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фільм, що входить до серії, веде прямо до своєї колекції: усі частини з їхньою доступністю та одна дія, щоб запросити все, чого немає в бібліотеці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "属于系列的电影可直接进入其合集：所有影片及其可观看状态一目了然，还能一次请求媒体库中缺少的全部影片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屬於系列的電影可直接進入其系列頁面：所有影片及其可觀看狀態一目了然，還能一次請求媒體庫中缺少的全部影片。"
          }
        }
      }
    },
    "changelog.1_0_0.detailNavigation.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránky s detaily na Apple TV nyní označují spodní okraj plovoucí šipkou, takže vám nic pod ním neunikne. Kolekce a playlisty se otevírají rovnou na seznamu položek a Přehrát spustí první nedokončený titul."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljesider på Apple TV markerer nu skærmkanten med en svævende pil, så intet nedenunder overses. Samlinger og afspilningslister åbner direkte på deres liste, og Afspil starter den første titel, du ikke har set færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detailseiten auf dem Apple TV markieren den unteren Bildschirmrand jetzt mit einem schwebenden Pfeil, damit nichts darunter übersehen wird. Sammlungen und Playlists öffnen direkt in ihrer Liste, und Wiedergabe startet den ersten noch nicht beendeten Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σελίδες λεπτομερειών στο Apple TV επισημαίνουν πλέον το κάτω όριο με ένα αιωρούμενο βέλος, ώστε να μην περνά τίποτα απαρατήρητο. Οι συλλογές και οι λίστες ανοίγουν κατευθείαν στη λίστα τους και η Αναπαραγωγή ξεκινά τον πρώτο τίτλο που δεν ολοκληρώσατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detail pages on Apple TV now mark the bottom of the screen with a floating arrow, so nothing below it goes unnoticed. Collections and playlists open right on their item list, and Play starts the first title you have not finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas de detalles en Apple TV ahora marcan el borde inferior con una flecha flotante, para que nada de lo que hay debajo pase desapercibido. Las colecciones y listas se abren directamente en su lista, y Reproducir inicia el primer título que no has terminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV:n tietosivut merkitsevät nyt näytön alareunan kelluvalla nuolella, joten mikään sen alla ei jää huomaamatta. Kokoelmat ja soittolistat avautuvat suoraan listaansa, ja Toista aloittaa ensimmäisen kesken jääneen nimikkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de détail sur Apple TV signalent désormais le bas de l'écran par une flèche flottante, pour que rien en dessous ne passe inaperçu. Les collections et listes s'ouvrent directement sur leur liste, et Lire démarre le premier titre non terminé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stranice s detaljima na Apple TV-u sada označavaju donji rub zaslona lebdećom strelicom, pa ništa ispod ne ostaje nezapaženo. Zbirke i playliste otvaraju se izravno na svom popisu, a Reproduciraj pokreće prvi nedovršeni naslov."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple TV részletes oldalai mostantól lebegő nyíllal jelölik a képernyő alját, így semmi nem marad észrevétlen. A gyűjtemények és lejátszási listák egyből a listájukon nyílnak meg, a Lejátszás pedig az első befejezetlen címet indítja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine di dettaglio su Apple TV ora segnalano il bordo inferiore con una freccia fluttuante, così nulla di ciò che sta sotto passa inosservato. Raccolte e playlist si aprono direttamente sul loro elenco e Riproduci avvia il primo titolo non finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV の詳細ページに、画面の下にまだ続きがあることを示す矢印が表示されるようになりました。コレクションとプレイリストは項目リストから開き、再生は見終わっていない最初の作品から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV의 상세 페이지가 이제 떠 있는 화살표로 화면 아래에 더 있음을 알려 줍니다. 컬렉션과 재생목록은 바로 항목 목록에서 열리고, 재생은 아직 다 보지 않은 첫 작품부터 시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljsider på Apple TV markerer nå nedre skjermkant med en svevende pil, så ingenting under blir oversett. Samlinger og spillelister åpnes rett på listen sin, og Spill av starter den første tittelen du ikke har sett ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detailpagina's op Apple TV markeren de onderrand nu met een zwevende pijl, zodat niets eronder onopgemerkt blijft. Collecties en afspeellijsten openen direct op hun lijst, en Afspelen start de eerste titel die je niet hebt uitgekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strony szczegółów na Apple TV oznaczają teraz dolną krawędź unoszącą się strzałką, więc nic poniżej nie umknie uwadze. Kolekcje i playlisty otwierają się od razu na swojej liście, a Odtwórz uruchamia pierwszy nieukończony tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas de detalhes na Apple TV agora marcam a borda inferior com uma seta flutuante, para que nada abaixo passe despercebido. Coleções e playlists abrem direto na lista de itens, e Reproduzir inicia o primeiro título que você não terminou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas de detalhes na Apple TV marcam agora o limite inferior do ecrã com uma seta flutuante, para que nada por baixo passe despercebido. Coleções e listas abrem diretamente na sua lista, e Reproduzir inicia o primeiro título que não terminou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paginile de detalii pe Apple TV marchează acum marginea de jos a ecranului cu o săgeată plutitoare, astfel încât nimic de dedesubt să nu treacă neobservat. Colecțiile și listele se deschid direct pe lista lor, iar Redare pornește primul titlu neterminat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страницы с описанием на Apple TV теперь отмечают нижний край экрана плавающей стрелкой, чтобы ничего под ней не осталось незамеченным. Коллекции и плейлисты открываются сразу на списке, а «Воспроизвести» запускает первый незавершённый фильм."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránky s detailmi na Apple TV teraz označujú spodný okraj obrazovky plávajúcou šípkou, takže nič pod ňou neunikne. Kolekcie a playlisty sa otvárajú priamo na svojom zozname a Prehrať spustí prvý nedokončený titul."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljsidor på Apple TV markerar nu skärmens nederkant med en svävande pil, så att inget nedanför missas. Samlingar och spellistor öppnas direkt på sin lista, och Spela upp startar den första titeln du inte sett klart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV'deki ayrıntı sayfaları artık ekranın alt sınırını süzülen bir okla işaretliyor, böylece altındakiler gözden kaçmıyor. Koleksiyonlar ve çalma listeleri doğrudan öğe listesinde açılıyor ve Oynat, bitirmediğiniz ilk yapımı başlatıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сторінки з описом на Apple TV тепер позначають нижній край екрана плавною стрілкою, щоб нічого під нею не лишилося непоміченим. Колекції та плейлисти відкриваються одразу на своєму списку, а «Відтворити» запускає перший незавершений фільм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 上的详情页现在会用一个浮动箭头标出屏幕下缘，提示下面还有内容。合集和播放列表直接从条目列表打开，播放会从你尚未看完的第一部开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 上的詳細資料頁現在會以浮動箭頭標示螢幕下緣，提示下方還有內容。合集與播放清單直接從項目列表開啟，播放會從你尚未看完的第一部開始。"
          }
        }
      }
    },
