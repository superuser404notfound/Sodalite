    "changelog.1_0_0.castCrew.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky herců na Apple TV jsou výrazně větší, jména a role se nyní vejdou celé místo oříznutí po pár znacích, a otevření herce přejde rovnou na jeho stránku, která se načte na místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollefotos på Apple TV er markant større, navne og roller er der nu plads til i stedet for at blive skåret af efter få tegn, og et tryk på en medvirkende åbner siden med det samme, mens den indlæses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besetzungsfotos auf dem Apple TV sind deutlich größer, Namen und Rollen passen jetzt hinein, statt nach wenigen Zeichen abgeschnitten zu werden, und eine Person öffnet ihre Seite sofort, während sie lädt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες του καστ στο Apple TV είναι πολύ μεγαλύτερες, τα ονόματα και οι ρόλοι πλέον χωρούν αντί να κόβονται μετά από λίγους χαρακτήρες, και η επιλογή ενός ηθοποιού ανοίγει αμέσως τη σελίδα του ενώ φορτώνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast portraits on Apple TV are much larger, names and roles now fit instead of being cut after a few characters, and opening a cast member goes straight to their page while it loads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos del reparto en Apple TV son mucho más grandes, los nombres y los papeles ahora caben en lugar de cortarse tras unos pocos caracteres, y al abrir a alguien su página aparece de inmediato mientras se carga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttelijäkuvat Apple TV:ssä ovat huomattavasti isompia, nimet ja roolit mahtuvat nyt kokonaan sen sijaan että ne katkeaisivat muutaman merkin jälkeen, ja näyttelijän avaaminen vie suoraan hänen sivulleen sen latautuessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les portraits de la distribution sur l'Apple TV sont nettement plus grands, les noms et les rôles tiennent enfin au lieu d'être coupés après quelques caractères, et ouvrir une personne affiche sa page immédiatement pendant le chargement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije glumaca na Apple TV-u znatno su veće, imena i uloge sada stanu umjesto da se odsijeku nakon nekoliko znakova, a otvaranje osobe odmah prikazuje njezinu stranicu dok se učitava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szereplők fotói az Apple TV-n jóval nagyobbak, a nevek és szerepek már kiférnek ahelyett, hogy néhány karakter után levágódnának, és egy személy megnyitása azonnal az oldalára visz, amíg az betöltődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto del cast su Apple TV sono molto più grandi, nomi e ruoli ora ci stanno invece di essere troncati dopo pochi caratteri, e aprire una persona mostra subito la sua pagina mentre si carica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV のキャスト写真が大きくなり、名前と役名が数文字で切れずに収まるようになりました。キャストを選ぶとページがすぐに開き、その場で読み込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV의 출연진 사진이 훨씬 커졌고, 이름과 배역이 몇 글자 만에 잘리지 않고 모두 표시됩니다. 출연자를 선택하면 페이지가 즉시 열리며 그 자리에서 불러옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollebildene på Apple TV er betydelig større, navn og roller får nå plass i stedet for å kuttes etter noen få tegn, og å åpne en person viser siden med én gang mens den lastes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Castfoto's op de Apple TV zijn een stuk groter, namen en rollen passen nu in plaats van na een paar tekens te worden afgekapt, en een castlid openen toont de pagina meteen terwijl die laadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia obsady na Apple TV są znacznie większe, nazwiska i role wreszcie się mieszczą zamiast urywać po kilku znakach, a otwarcie osoby od razu pokazuje jej stronę w trakcie wczytywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos do elenco na Apple TV estão bem maiores, nomes e papéis agora cabem em vez de serem cortados após alguns caracteres, e abrir alguém mostra a página na hora enquanto ela carrega."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotografias do elenco na Apple TV estão bastante maiores, os nomes e papéis agora cabem em vez de serem cortados ao fim de alguns caracteres, e abrir alguém mostra a página de imediato enquanto carrega."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiile distribuției pe Apple TV sunt mult mai mari, numele și rolurile încap acum în loc să fie tăiate după câteva caractere, iar deschiderea unei persoane afișează imediat pagina în timp ce se încarcă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографии актёров на Apple TV стали заметно крупнее, имена и роли теперь помещаются целиком, а не обрезаются после нескольких символов, и открытие актёра сразу показывает его страницу во время загрузки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografie obsadenia na Apple TV sú výrazne väčšie, mená a úlohy sa teraz zmestia namiesto orezania po pár znakoch a otvorenie osoby zobrazí jej stránku okamžite počas načítania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollbilderna på Apple TV är betydligt större, namn och roller får nu plats i stället för att kapas efter några tecken, och att öppna en skådespelare visar sidan direkt medan den laddas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV'deki oyuncu fotoğrafları çok daha büyük, adlar ve roller birkaç karakter sonra kesilmek yerine artık sığıyor ve bir oyuncuyu açmak sayfasını yüklenirken hemen gösteriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографії акторів на Apple TV помітно більші, імена та ролі тепер вміщуються повністю, а не обрізаються після кількох символів, а відкриття актора одразу показує його сторінку під час завантаження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 上的演员照片明显更大，姓名和角色不再几个字就被截断，选择演员会立即打开其页面并就地加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 上的演員照片明顯更大，姓名與角色不再幾個字就被截斷，選擇演員會立即開啟其頁面並就地載入。"
          }
        }
      }
    },
    "changelog.1_0_0.childLock.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedním klepnutím zamknete přehrávač na iPhonu a iPadu, aby dítě nemohlo nic změnit; odemknete podržením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tryk låser afspilleren på iPhone og iPad, så et barn ikke kan ændre noget; hold nede for at låse op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tipp sperrt den Player auf iPhone und iPad, damit ein Kind nichts verändern kann; zum Entsperren gedrückt halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα άγγιγμα κλειδώνει το πρόγραμμα αναπαραγωγής σε iPhone και iPad ώστε ένα παιδί να μην μπορεί να αλλάξει τίποτα· κρατήστε πατημένο για ξεκλείδωμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One tap locks the player on iPhone and iPad so a child can't change anything; press and hold to unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque bloquea el reproductor en iPhone y iPad para que un niño no pueda cambiar nada; mantén pulsado para desbloquear."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdellä napautuksella lukitset soittimen iPhonessa ja iPadissa, jottei lapsi voi muuttaa mitään; avaa lukitus pitämällä painettuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche verrouille le lecteur sur iPhone et iPad pour qu'un enfant ne puisse rien changer ; maintenez pour déverrouiller."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednim dodirom zaključavate reproduktor na iPhoneu i iPadu kako dijete ne može ništa promijeniti; držite za otključavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy koppintás zárolja a lejátszót iPhone-on és iPaden, hogy a gyerek ne változtathasson semmit; a feloldáshoz tartsa lenyomva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tocco blocca il lettore su iPhone e iPad così un bambino non può cambiare nulla; tieni premuto per sbloccare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneとiPadでワンタップでプレーヤーをロックし、子供が何も変更できないようにします。長押しでロック解除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone과 iPad에서 한 번의 탭으로 플레이어를 잠가 아이가 아무것도 바꿀 수 없게 합니다. 길게 눌러 잠금 해제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett trykk låser spilleren på iPhone og iPad så et barn ikke kan endre noe; hold inne for å låse opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén tik vergrendelt de speler op iPhone en iPad zodat een kind niets kan veranderen; houd vast om te ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno dotknięcie blokuje odtwarzacz na iPhonie i iPadzie, aby dziecko nie mogło nic zmienić; przytrzymaj, aby odblokować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque bloqueia o player no iPhone e no iPad para que uma criança não possa mudar nada; mantenha pressionado para desbloquear."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque bloqueia o leitor no iPhone e no iPad para que uma criança não possa alterar nada; mantenha premido para desbloquear."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atingere blochează playerul pe iPhone și iPad, astfel încât un copil să nu poată schimba nimic; ține apăsat pentru a debloca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно касание блокирует плеер на iPhone и iPad, чтобы ребёнок ничего не изменил; удерживайте для разблокировки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedným klepnutím zamknete prehrávač na iPhone a iPade, aby dieťa nemohlo nič zmeniť; odomknete podržaním."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tryckning låser spelaren på iPhone och iPad så att ett barn inte kan ändra något; håll in för att låsa upp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek dokunuşla iPhone ve iPad'de oynatıcıyı kilitleyin, böylece bir çocuk hiçbir şeyi değiştiremez; kilidi açmak için basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одне торкання блокує програвач на iPhone та iPad, щоб дитина нічого не змінила; утримуйте, щоб розблокувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 和 iPad 上轻点一下即可锁定播放器，孩子无法更改任何内容；按住即可解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 和 iPad 上輕點一下即可鎖定播放器，孩子無法更改任何內容；按住即可解鎖。"
          }
        }
      }
    },
