          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中: 別の iCloud アカウントでサインインされました。このアカウントで使うには同期をオンに戻してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지됨: 다른 iCloud 계정으로 로그인했습니다. 이 계정에서 사용하려면 동기화를 다시 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
