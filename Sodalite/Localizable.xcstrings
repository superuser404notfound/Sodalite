          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvioitu keston ja toistokertojen perusteella. Uusintakatselut mukana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimé à partir de la durée et du nombre de lectures. Visionnages répétés inclus."
