    "settings.playback.subtitle.delay.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posune titulky vůči zvuku. Záporné hodnoty je zobrazí dříve, kladné později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskyder underteksterne i forhold til lyden. Negativ = før, positiv = efter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt Untertitel relativ zum Ton. Minus = früher, Plus = später."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινεί τους υπότιτλους ως προς τον ήχο. Αρνητικό = νωρίτερα, θετικό = αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shifts subtitles relative to audio. Negative = earlier, positive = later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza los subtítulos respecto al audio. Negativo = antes, positivo = después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää tekstitykset suhteessa ääneen. Miinus = aikaisempi, plus = myöhempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale les sous-titres par rapport à l'audio. Négatif = avant, positif = après."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiče titlove u odnosu na zvuk. Negativno = ranije, pozitivno = kasnije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltolja a feliratot a hanghoz képest. Negatív = előbb, pozitív = később."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta i sottotitoli rispetto all'audio. Negativo = prima, positivo = dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声に対して字幕をずらします。マイナス=早く、プラス=遅く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오를 기준으로 자막 시점을 이동합니다. 음수 = 더 빨리, 양수 = 더 늦게."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskyver tekstene i forhold til lyden. Negativ = tidligere, positiv = senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuift ondertitels ten opzichte van het geluid. Negatief = eerder, positief = later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa napisy względem dźwięku. Wartości ujemne = wcześniej, dodatnie = później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca as legendas em relação ao áudio. Negativo = antes, positivo = depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca as legendas em relação ao áudio. Negativo = antes, positivo = depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decalează subtitrările față de audio. Negativ = mai devreme, pozitiv = mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смещает субтитры относительно звука. Минус — раньше, плюс — позже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunie titulky voči zvuku. Záporné = skôr, kladné = neskôr."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förskjuter undertexter mot ljudet. Negativ = tidigare, positiv = senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazıları sese göre kaydırır. Negatif = daha erken, pozitif = daha geç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміщує субтитри відносно звуку. Мінус — раніше, плюс — пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相对音频偏移字幕时间。负值=更早,正值=更晚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相對音訊偏移字幕時間。負值=更早,正值=更晚。"
          }
        }
      }
    },
