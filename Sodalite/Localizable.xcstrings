    "changelog.1_0_0.appearance.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber si barvu zvýraznění a pozadí, od Graphite Glass po OLED Black. Balíček pro podporovatele přidává další palety a animovaná pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en accentfarve og en baggrund, fra Graphite Glass til OLED Black. Supporter-pakken tilføjer flere paletter og animerede baggrunde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Akzentfarbe und einen Hintergrund, von Graphite Glass bis OLED Black. Das Unterstützer-Paket bringt weitere Paletten und animierte Hintergründe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε χρώμα τονισμού και φόντο, από Graphite Glass έως OLED Black. Το πακέτο υποστηρικτή προσθέτει κι άλλες παλέτες και κινούμενα φόντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick an accent colour and a background, from Graphite Glass to OLED Black. The Supporter Pack adds curated palettes and animated backgrounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un color de acento y un fondo, de Graphite Glass a OLED Black. El Pack de Apoyo añade paletas seleccionadas y fondos animados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse korostusväri ja tausta, Graphite Glassista OLED Blackiin. Tukijapaketti tuo lisää paletteja ja animoituja taustoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une couleur d'accent et un fond, de Graphite Glass à OLED Black. Le pack Soutien ajoute des palettes choisies et des fonds animés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberi boju naglaska i pozadinu, od Graphite Glass do OLED Black. Paket podrške donosi dodatne palete i animirane pozadine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz kiemelőszínt és hátteret, a Graphite Glasstól az OLED Blackig. A Támogatói csomag további palettákat és animált háttereket ad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un colore d'accento e uno sfondo, da Graphite Glass a OLED Black. Il pacchetto Sostenitore aggiunge altre palette e sfondi animati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセントカラーと背景を選べます。Graphite GlassからOLED Blackまで。サポーターパックでは厳選パレットとアニメーション背景が加わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조 색상과 배경을 고르세요. Graphite Glass부터 OLED Black까지. 서포터 팩에는 엄선된 팔레트와 움직이는 배경이 더해집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en aksentfarge og en bakgrunn, fra Graphite Glass til OLED Black. Støttepakken gir flere paletter og animerte bakgrunner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een accentkleur en een achtergrond, van Graphite Glass tot OLED Black. Het Supporterpakket voegt extra paletten en bewegende achtergronden toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kolor akcentu i tło, od Graphite Glass po OLED Black. Pakiet wsparcia dodaje kolejne palety i animowane tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma cor de destaque e um fundo, do Graphite Glass ao OLED Black. O Pacote de Apoio adiciona paletas selecionadas e fundos animados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe uma cor de destaque e um fundo, do Graphite Glass ao OLED Black. O Pacote de Apoio acrescenta paletas selecionadas e fundos animados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege o culoare de accent și un fundal, de la Graphite Glass la OLED Black. Pachetul de susținere adaugă palete selectate și fundaluri animate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите акцентный цвет и фон, от Graphite Glass до OLED Black. Пакет поддержки добавляет отобранные палитры и анимированные фоны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber si farbu zvýraznenia a pozadie, od Graphite Glass po OLED Black. Balík pre podporovateľov pridáva ďalšie palety a animované pozadia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en accentfärg och en bakgrund, från Graphite Glass till OLED Black. Supporterpaketet lägger till fler paletter och animerade bakgrunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir vurgu rengi ve arka plan seçin, Graphite Glass'tan OLED Black'e. Destekçi Paketi seçilmiş paletler ve hareketli arka planlar ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть акцентний колір і фон, від Graphite Glass до OLED Black. Пакунок підтримки додає дібрані палітри та анімовані фони."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挑一个强调色和背景，从 Graphite Glass 到 OLED Black。支持者礼包还会加入精选配色和动态背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挑一個強調色和背景，從 Graphite Glass 到 OLED Black。支持者禮包還會加入精選配色和動態背景。"
          }
        }
      }
    },
