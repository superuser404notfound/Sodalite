    "profile.rejected.detail %@" : {
      "comment" : "Alert body after a remembered profile was dropped because the server refused its saved sign-in",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server odmítl uložené přihlášení pro %@, proto byl profil z tohoto zařízení odebrán. Pokud účet stále existuje, přihlas se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste det gemte login for %@, så profilen blev fjernet fra denne enhed. Log ind igen, hvis kontoen stadig findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die gespeicherte Anmeldung für %@ abgelehnt, deshalb wurde das Profil von diesem Gerät entfernt. Melde dich neu an, falls das Konto noch existiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε την αποθηκευμένη σύνδεση για %@, οπότε το προφίλ αφαιρέθηκε από αυτή τη συσκευή. Συνδέσου ξανά αν ο λογαριασμός υπάρχει ακόμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the saved sign-in for %@, so the profile was removed from this device. Sign in again if the account still exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó el inicio de sesión guardado de %@, así que el perfil se eliminó de este dispositivo. Vuelve a iniciar sesión si la cuenta sigue existiendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin hylkäsi tallennetun kirjautumisen profiilille %@, joten profiili poistettiin tästä laitteesta. Kirjaudu uudelleen, jos tili on yhä olemassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la connexion enregistrée de %@, le profil a donc été supprimé de cet appareil. Reconnectez-vous si le compte existe encore."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj je odbio spremljenu prijavu za %@, pa je profil uklonjen s ovog uređaja. Prijavi se ponovno ako račun još postoji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló elutasította %@ mentett bejelentkezését, ezért a profil eltávolítva erről az eszközről. Jelentkezz be újra, ha a fiók még létezik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato l'accesso salvato di %@, quindi il profilo è stato rimosso da questo dispositivo. Accedi di nuovo se l'account esiste ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが %@ の保存済みサインインを拒否したため、このデバイスからプロファイルを削除しました。アカウントがまだ存在する場合は、もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 %@의 저장된 로그인을 거부하여 이 기기에서 프로필을 제거했습니다. 계정이 아직 있다면 다시 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren avviste den lagrede innloggingen for %@, så profilen ble fjernet fra denne enheten. Logg inn på nytt hvis kontoen fortsatt finnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft de opgeslagen aanmelding voor %@ geweigerd, dus is het profiel van dit apparaat verwijderd. Log opnieuw in als het account nog bestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odrzucił zapisane logowanie profilu %@, więc profil został usunięty z tego urządzenia. Zaloguj się ponownie, jeśli konto nadal istnieje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o login salvo de %@, então o perfil foi removido deste dispositivo. Entre de novo se a conta ainda existir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o início de sessão guardado de %@, por isso o perfil foi removido deste dispositivo. Inicie sessão novamente se a conta ainda existir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul a refuzat autentificarea salvată pentru %@, așa că profilul a fost eliminat de pe acest dispozitiv. Conectează-te din nou dacă acest cont mai există."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отклонил сохранённый вход для %@, поэтому профиль удалён с этого устройства. Войдите снова, если учётная запись ещё существует."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server odmietol uložené prihlásenie pre %@, preto bol profil z tohto zariadenia odstránený. Ak účet stále existuje, prihlás sa znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern nekade den sparade inloggningen för %@, så profilen togs bort från den här enheten. Logga in igen om kontot fortfarande finns."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu %@ için kayıtlı oturum açma bilgilerini reddetti, bu yüzden profil bu cihazdan kaldırıldı. Hesap hâlâ varsa yeniden giriş yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер відхилив збережений вхід для %@, тому профіль видалено з цього пристрою. Увійдіть знову, якщо обліковий запис ще існує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝了 %@ 的已保存登录信息，因此该配置文件已从此设备移除。如果账户仍然存在，请重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器拒絕了 %@ 的已儲存登入資訊，因此該設定檔已從此裝置移除。如果帳戶仍然存在，請重新登入。"
          }
        }
      }
    },
