    "player.error.streamNotFound.body" : {
      "comment" : "Error body when the origin answered 404/410 for the stream",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tento soubor už nemá. Mohl být přesunut nebo odstraněn z knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren har ikke længere denne fil. Den kan være flyttet eller fjernet fra biblioteket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diese Datei nicht mehr. Sie wurde möglicherweise verschoben oder aus der Bibliothek entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
