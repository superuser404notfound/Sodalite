    "changelog.1_0_0.forcedSubtitles.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nápisy a cizojazyčné dialogy se zobrazí i s vypnutými titulky, přesně jako na diskovém přehrávači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilte og fremmedsproget dialog vises stadig, mens dine undertekster er slået fra, ligesom på en diskafspiller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schilder und fremdsprachige Dialoge erscheinen weiterhin, während deine Untertitel aus sind, so wie es ein Disc-Player macht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πινακίδες και ξενόγλωσσοι διάλογοι εμφανίζονται ακόμη κι όταν οι υπότιτλοι είναι κλειστοί, όπως σε έναν δισκοαναγνώστη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signs and foreign dialogue still appear while your subtitles are off, the way a disc player does it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los carteles y los diálogos en otro idioma siguen apareciendo con los subtítulos desactivados, como en un reproductor de discos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyltit ja vieraskieliset vuorosanat näkyvät edelleen, vaikka tekstitykset ovat pois päältä, kuten levysoittimessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les panneaux et les dialogues en langue étrangère restent affichés quand vos sous-titres sont désactivés, comme sur un lecteur de disque."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natpisi i strani dijalozi i dalje se prikazuju dok su titlovi isključeni, kao na disk playeru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feliratok és az idegen nyelvű párbeszédek akkor is megjelennek, ha a feliratok ki vannak kapcsolva, ahogy egy lemezlejátszónál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartelli e dialoghi in lingua straniera restano visibili anche con i sottotitoli disattivati, come su un lettore di dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕をオフにしていても、標識や外国語のセリフはそのまま表示されます。ディスクプレーヤーと同じ挙動です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막을 꺼도 표지판과 외국어 대사는 그대로 표시됩니다. 디스크 플레이어와 같은 방식입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilt og fremmedspråklig dialog vises fortsatt mens undertekstene dine er av, slik en plateespiller gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borden en anderstalige dialogen blijven zichtbaar terwijl je ondertiteling uit staat, net als bij een discspeler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisy na ekranie i obcojęzyczne dialogi nadal się pojawiają, gdy napisy są wyłączone, tak jak w odtwarzaczu płyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placas e diálogos em outro idioma continuam aparecendo com as legendas desligadas, como em um player de disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placas e diálogos noutra língua continuam a aparecer com as legendas desligadas, como num leitor de discos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicatoarele și dialogurile în altă limbă apar în continuare cu subtitrările oprite, ca la un player de discuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надписи и иноязычные реплики показываются даже при выключенных субтитрах, как на дисковом плеере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nápisy a cudzojazyčné dialógy sa zobrazujú aj s vypnutými titulkami, presne ako na diskovom prehrávači."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyltar och främmande dialog visas fortfarande medan dina undertexter är av, precis som på en skivspelare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabelalar ve yabancı dildeki diyaloglar altyazılarınız kapalıyken de görünür, tıpkı bir disk oynatıcıdaki gibi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Написи та іншомовні репліки показуються навіть із вимкненими субтитрами, як на дисковому програвачі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭字幕时，画面上的标识和外语对白依然会显示，和碟机一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉字幕時，畫面上的標示和外語對白依然會顯示，和碟機一樣。"
          }
        }
      }
    },
