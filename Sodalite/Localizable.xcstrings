    "changelog.0_5_0.touchpadAccuracy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlostní limit na dotykové ploše Siri Remote ignoruje posun prstu před kliknutím, takže opřený palec už náhodně neposune zaměření na další tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hastighedsgrænse på Siri Remote-touchpad'en ignorerer fingerflytning før et klik, så det at hvile tommelfingeren ikke længere ved et uheld flytter fokus til den næste knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Geschwindigkeits-Schwelle am Siri-Remote-Touchpad ignoriert Finger-Drift vor einem Klick, sodass ein abgesetzter Daumen nicht mehr versehentlich den Fokus auf den nächsten Button verschiebt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα όριο ταχύτητας στο touchpad του Siri Remote αγνοεί τη μετατόπιση του δακτύλου πριν από το κλικ, ώστε η ανάπαυση του αντίχειρα να μη μετακινεί πια κατά λάθος την εστίαση στο επόμενο κουμπί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A velocity gate on the Siri Remote touchpad ignores finger drift before a click, so resting your thumb no longer accidentally moves focus to the next button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un umbral de velocidad en el touchpad del Siri Remote ignora el desplazamiento del dedo antes de un clic, así que apoyar el pulgar ya no mueve por accidente el foco al botón siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeusraja Siri Remoten kosketuslevyllä jättää huomiotta sormen liikkeen ennen napsautusta, joten peukalon lepuuttaminen ei enää siirrä kohdistusta vahingossa seuraavaan painikkeeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seuil de vitesse sur le pavé tactile du Siri Remote ignore le glissement du doigt avant un clic, donc poser le pouce ne déplace plus accidentellement le focus sur le bouton suivant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brzinski prag na dodirnoj plohi Siri Remotea ignorira pomicanje prsta prije klika, pa odlaganje palca više ne miče fokus na sljedeću tipku slučajno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Siri Remote érintőfelületén lévő sebességküszöb figyelmen kívül hagyja az ujj elcsúszását kattintás előtt, így a hüvelykujj megpihentetése többé nem mozgatja véletlenül a fókuszt a következő gombra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una soglia di velocità sul touchpad del Siri Remote ignora la deriva del dito prima di un clic, così appoggiare il pollice non sposta più per sbaglio il focus sul pulsante successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remoteのタッチパッドに速度しきい値を設けたことで、クリック前の指のずれが無視されます。親指を置いてもフォーカスが意図せず隣のボタンへ動くことはなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote 터치패드에 속도 임계값을 두어 클릭 전 손가락 드리프트를 무시합니다. 엄지를 올려둬도 포커스가 우연히 다음 버튼으로 이동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hastighetsgrense på Siri Remote-pekeflaten ignorerer fingerforskyvning før et klikk, så å la tommelen hvile flytter ikke lenger fokus til neste knapp ved et uhell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een snelheidsgrens op het touchpad van de Siri Remote negeert vingerafwijking voor een klik, zodat het neerleggen van je duim de focus niet langer per ongeluk naar de volgende knop verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próg prędkości na touchpadzie Siri Remote ignoruje przesunięcie palca przed kliknięciem, więc oparcie kciuka nie przesuwa już przypadkowo fokusu na następny przycisk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um limite de velocidade no touchpad do Siri Remote ignora o deslizamento do dedo antes de um clique, então apoiar o polegar não move mais o foco para o botão seguinte por acidente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um limite de velocidade no touchpad do Siri Remote ignora o deslizamento do dedo antes de um clique, por isso apoiar o polegar já não move o foco para o botão seguinte por acidente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prag de viteză pe touchpad-ul Siri Remote ignoră alunecarea degetului înainte de clic, astfel încât sprijinirea degetului mare nu mai mută accidental focusul pe butonul următor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог скорости на тачпаде Siri Remote игнорирует смещение пальца перед нажатием, так что положенный большой палец больше не смещает фокус на соседнюю кнопку случайно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rýchlostný limit na dotykovej ploche Siri Remote ignoruje posun prsta pred kliknutím, takže opretý palec už náhodne neposunie zameranie na ďalšie tlačidlo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hastighetströskel på Siri Remote-pekplattan ignorerar fingerförskjutning före ett klick, så att vila tummen inte längre råkar flytta fokus till nästa knapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote dokunmatik yüzeyindeki hız eşiği, tıklamadan önceki parmak kaymasını yok sayar; böylece başparmağınızı dayadığınızda odak yanlışlıkla bir sonraki düğmeye kaymaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поріг швидкості на трекпаді Siri Remote ігнорує зміщення пальця перед натисканням, тож покладений великий палець більше не зміщує фокус на сусідню кнопку випадково."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote 触控板上的速度阈值会忽略点击前的手指漂移,因此将拇指放在触控板上不会再意外把焦点移到下一个按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote 觸控板上的速度閾值會忽略點擊前的手指漂移,所以將拇指放在觸控板上不會再意外把焦點移到下一個按鈕。"
          }
        }
      }
    },
