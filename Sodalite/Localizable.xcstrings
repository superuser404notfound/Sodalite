    "settings.appearance.subtitle" : {
      "comment" : "Subtitle on the Appearance screen, summarizing what it customizes",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobte loga, karty a obrázky pomocí tří bezplatných barev zvýraznění, Grafitového skla a OLED černé, plus palet pro podporovatele a prémiových animovaných pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas logoer, kort og billeder med tre gratis fremhævningsfarver, Grafitglas og OLED-sort samt supporter-paletter og animerede premiumbaggrunde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe Logos, Karten und Bilder mit drei kostenlosen Akzentfarben, Graphitglas und OLED-Schwarz sowie Supporter-Paletten und animierten Premium-Hintergründen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόστε λογότυπα, κάρτες και εικόνες με τρία δωρεάν χρώματα έμφασης, Γυαλί γραφίτη και Μαύρο OLED, καθώς και παλέτες υποστηρικτών και premium κινούμενα φόντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customize logos, cards, and images with three free accents, Graphite Glass and OLED Black, plus Supporter palettes and premium animated backgrounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza logotipos, tarjetas e imágenes con tres colores de acento gratis, Cristal de grafito y Negro OLED, además de paletas del Supporter Pack y fondos animados prémium."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukauta logoja, kortteja ja kuvia kolmella ilmaisella korostusvärillä, Grafiittilasilla ja OLED-mustalla sekä tukijapaleteilla ja animoiduilla premium-taustoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnalisez les logos, cartes et images avec trois couleurs d’accentuation gratuites, Verre graphite et Noir OLED, ainsi que des palettes Supporter et des arrière-plans animés premium."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite logotipe, kartice i slike s tri besplatne naglasne boje, Grafitnim staklom i OLED crnom te paletama za podržavatelje i premium animiranim pozadinama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szabd személyre a logókat, kártyákat és képeket három ingyenes kiemelőszínnel, Grafitüveg és OLED-fekete háttérrel, valamint támogatói palettákkal és prémium animált hátterekkel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizza logo, schede e immagini con tre colori d’accento gratuiti, Vetro grafite e Nero OLED, oltre a palette per sostenitori e sfondi animati premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロゴ、カード、画像に加え、3色の無料アクセント、グラファイトガラスとOLEDブラック、サポーター向けパレット、プレミアムアニメーション背景をカスタマイズできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로고, 카드, 이미지를 세 가지 무료 강조 색상, 그래파이트 글래스 및 OLED 블랙 배경, 서포터 팔레트와 프리미엄 애니메이션 배경으로 꾸밀 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpass logoer, kort og bilder med tre gratis aksentfarger, Grafittglass og OLED-svart samt supporterpaletter og animerte premiumbakgrunner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas logo's, kaarten en afbeeldingen aan met drie gratis accentkleuren, Grafietglas en OLED-zwart, plus supporterspaletten en premium geanimeerde achtergronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj logo, karty i obrazy za pomocą trzech bezpłatnych kolorów akcentu, Grafitowego szkła i Czerni OLED, a także palet dla wspierających i animowanych teł premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize logotipos, cartões e imagens com três cores de destaque grátis, Vidro grafite e Preto OLED, além de paletas para apoiadores e fundos animados premium."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize logótipos, cartões e imagens com três cores de realce grátis, Vidro de grafite e Preto OLED, além de paletas para apoiantes e fundos animados premium."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizează logourile, cardurile și imaginile cu trei culori de accent gratuite, Sticlă grafit și Negru OLED, plus palete pentru susținători și fundaluri animate premium."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте логотипы, карточки и изображения с тремя бесплатными акцентными цветами, Графитовым стеклом и Чёрным OLED, а также палитрами для сторонников и премиальными анимированными фонами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prispôsobte logá, karty a obrázky pomocou troch bezplatných farieb zvýraznenia, Grafitového skla a OLED čiernej, plus paliet pre podporovateľov a prémiových animovaných pozadí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassa logotyper, kort och bilder med tre kostnadsfria accentfärger, Grafitglas och OLED-svart samt supporterpaletter och animerade premiumbakgrunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logoları, kartları ve görselleri üç ücretsiz vurgu rengi, Grafit cam ve OLED siyahının yanı sıra destekçi paletleri ve premium animasyonlu arka planlarla özelleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте логотипи, картки та зображення з трьома безкоштовними акцентними кольорами, Графітовим склом і Чорним OLED, а також палітрами для прихильників і преміальними анімованими фонами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标志、卡片和图片，可使用三种免费强调色、石墨玻璃和 OLED 纯黑背景，以及支持者调色板和高级动态背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標誌、卡片和圖片，可使用三種免費強調色、石墨玻璃和 OLED 純黑背景，以及支持者調色盤和進階動態背景。"
          }
        }
      }
    },
