    "settings.tabs.catalog.subtitle" : {
      "comment" : "Row subtitle for the Catalog tab toggle",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procházení a žádosti v Jellyseerru. Vypnuto skryje i výsledky katalogu v Hledat a na stránkách osob."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemse og anmod via Jellyseerr. Fra skjuler også katalogresultater i Søg og på personsider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr durchstöbern und anfragen. Aus blendet auch Katalog-Treffer in der Suche und auf Personenseiten aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιήγηση και αιτήματα Jellyseerr. Απενεργοποιημένο κρύβει και τα αποτελέσματα καταλόγου στην Αναζήτηση και στις σελίδες προσώπων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr browsing and requests. Off also hides catalog results in Search and on person pages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explorar y solicitar en Jellyseerr. Desactivado también oculta los resultados del catálogo en Buscar y en las páginas de personas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr-selailu ja -pyynnöt. Pois piilottaa myös luettelotulokset Haussa ja henkilösivuilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigation et demandes Jellyseerr. Désactivé, les résultats du catalogue disparaissent aussi de la Recherche et des pages de personnes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledavanje i zahtjevi putem Jellyseerra. Isključeno skriva i rezultate kataloga u Pretrazi te na stranicama osoba."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr böngészés és kérések. Kikapcsolva a katalógustalálatok a Keresésben és a személyoldalakon is eltűnnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplorazione e richieste Jellyseerr. Disattivata nasconde anche i risultati del catalogo in Cerca e nelle pagine delle persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr の閲覧とリクエスト。オフにすると検索と人物ページのカタログ結果も非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr 둘러보기와 요청. 끄면 검색과 인물 페이지의 카탈로그 결과도 숨겨집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utforsking og forespørsler via Jellyseerr. Av skjuler også katalogtreff i Søk og på personsider."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladeren en aanvragen via Jellyseerr. Uit verbergt ook catalogusresultaten in Zoeken en op personenpagina's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądanie i prośby w Jellyseerr. Wyłączenie ukrywa też wyniki katalogu w Szukaj i na stronach osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegação e pedidos no Jellyseerr. Desativado, os resultados do catálogo também somem da Busca e das páginas de pessoas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegação e pedidos no Jellyseerr. Desativado, os resultados do catálogo também desaparecem da Pesquisa e das páginas de pessoas."
