    "catalog.request.cancel.confirm.message" : {
      "comment" : "Explains that removing the request does not stop a running download",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní požadavek v Jellyseerr. Již probíhající stahování v Sonarr nebo Radarr se nezastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter anmodningen i Jellyseerr. Downloads, der allerede er i gang i Sonarr eller Radarr, stoppes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht die Anfrage in Jellyseerr. Bereits laufende Downloads in Sonarr oder Radarr werden nicht gestoppt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει το αίτημα στο Jellyseerr. Οι λήψεις που εκτελούνται ήδη στο Sonarr ή στο Radarr δεν σταματούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the request in Jellyseerr. Downloads already running in Sonarr or Radarr are not stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la solicitud en Jellyseerr. Las descargas que ya están en curso en Sonarr o Radarr no se detienen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa pyynnön Jellyseerristä. Sonarrissa tai Radarrissa jo käynnissä olevia latauksia ei pysäytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la demande dans Jellyseerr. Les téléchargements déjà en cours dans Sonarr ou Radarr ne sont pas arrêtés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briše zahtjev u Jellyseerru. Preuzimanja koja su već pokrenuta u Sonarru ili Radarru neće se zaustaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli a kérést a Jellyseerrben. A Sonarrban vagy Radarrban már futó letöltések nem állnak le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la richiesta in Jellyseerr. I download già in corso in Sonarr o Radarr non vengono interrotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr のリクエストを削除します。Sonarr や Radarr で進行中のダウンロードは停止されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr에서 요청을 삭제합니다. Sonarr 또는 Radarr에서 이미 진행 중인 다운로드는 중단되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter forespørselen i Jellyseerr. Nedlastinger som allerede kjører i Sonarr eller Radarr, stoppes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert het verzoek in Jellyseerr. Downloads die al lopen in Sonarr of Radarr worden niet gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa żądanie w Jellyseerr. Pobierania trwające już w Sonarr lub Radarr nie zostaną zatrzymane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui a solicitação no Jellyseerr. Downloads já em andamento no Sonarr ou Radarr não são interrompidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina o pedido no Jellyseerr. As transferências já em curso no Sonarr ou Radarr não são interrompidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge cererea din Jellyseerr. Descărcările deja pornite în Sonarr sau Radarr nu sunt oprite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет запрос в Jellyseerr. Уже запущенные загрузки в Sonarr или Radarr не останавливаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstráni požiadavku v Jellyseerr. Už prebiehajúce sťahovania v Sonarr alebo Radarr sa nezastavia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort begäran i Jellyseerr. Nedladdningar som redan pågår i Sonarr eller Radarr stoppas inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteği Jellyseerr üzerinde siler. Sonarr veya Radarr üzerinde hâlihazırda süren indirmeler durdurulmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє запит у Jellyseerr. Завантаження, які вже виконуються в Sonarr або Radarr, не зупиняються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Jellyseerr 中删除该请求。Sonarr 或 Radarr 中正在进行的下载不会停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Jellyseerr 中刪除該請求。Sonarr 或 Radarr 中正在進行的下載不會停止。"
          }
        }
      }
    },
