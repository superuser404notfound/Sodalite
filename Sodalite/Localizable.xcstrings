    "multiServer.addURL.dialog.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte druhou adresu, aby aplikace mohla automaticky přepínat mezi domácí sítí a mimo ni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en ekstra adresse, så appen automatisk kan skifte mellem hjemme og på farten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere eine zweite Adresse, damit die App automatisch zwischen zu Hause und unterwegs wechselt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε μια δεύτερη διεύθυνση, ώστε η εφαρμογή να εναλλάσσεται αυτόματα μεταξύ οικιακού δικτύου και εκτός σπιτιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a second address so the app can switch automatically between home and away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una segunda dirección para que la app pueda cambiar automáticamente entre casa y fuera de casa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna toinen osoite, jotta sovellus voi vaihtaa automaattisesti kotiverkon ja etäyhteyden välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une seconde adresse afin que l'app puisse basculer automatiquement entre le domicile et l'extérieur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremi drugu adresu kako bi se aplikacija mogla automatski prebacivati između kućne mreže i izvan nje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ments el egy második címet, hogy az alkalmazás automatikusan válthasson otthoni és távoli hálózat között."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un secondo indirizzo per consentire all'app di passare automaticamente tra casa e fuori casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅と外出先を自動で切り替えられるように、もう一つのアドレスを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 집과 외부 사이를 자동으로 전환할 수 있도록 두 번째 주소를 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre en ekstra adresse slik at appen kan bytte automatisk mellom hjemme og på farten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een tweede adres zodat de app automatisch kan wisselen tussen thuis en onderweg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
