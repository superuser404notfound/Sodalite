    "changelog.1_0_0.restart.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvek Od začátku v přehrávači vrátí film nebo epizodu na začátek, aniž bys opustil přehrávání, a bod pokračování se posune hned s ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappen Fra start i afspilleren sender en film eller et afsnit tilbage til begyndelsen uden at forlade afspilningen, og dit fortsæt-punkt følger med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Von vorn im Player springt einen Film oder eine Folge zurück an den Anfang, ohne die Wiedergabe zu verlassen, und der Fortsetzungspunkt zieht sofort mit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κουμπί Από την αρχή στο πρόγραμμα αναπαραγωγής γυρίζει μια ταινία ή ένα επεισόδιο στην αρχή χωρίς να βγεις από την αναπαραγωγή, και το σημείο συνέχισης ακολουθεί αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A From Start control in the player jumps a movie or episode back to the beginning without leaving playback, and your resume point follows immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El control Desde el inicio del reproductor devuelve una película o un episodio al principio sin salir de la reproducción, y tu punto de continuación se actualiza al momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soittimen Alusta-painike palauttaa elokuvan tai jakson alkuun poistumatta toistosta, ja jatkamiskohta seuraa heti perässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande Depuis le début du lecteur ramène un film ou un épisode au commencement sans quitter la lecture, et votre point de reprise suit immédiatement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrola Od početka u reproduktoru vraća film ili epizodu na početak bez izlaska iz reprodukcije, a mjesto nastavka odmah se pomiče s njom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszó Elölről gombja a film vagy epizód elejére ugrik anélkül, hogy kilépnél a lejátszásból, és a folytatási pont azonnal követi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il comando Dall'inizio nel player riporta un film o un episodio al principio senza uscire dalla riproduzione, e il punto di ripresa si aggiorna subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーの「最初から」で、再生を終えずに映画やエピソードを先頭に戻せます。続きの位置もすぐに追従します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어의 처음부터 버튼으로 재생을 벗어나지 않고 영화나 에피소드를 맨 앞으로 되돌릴 수 있고, 이어보기 지점도 바로 따라옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappen Fra start i spilleren sender en film eller en episode tilbake til begynnelsen uten å forlate avspillingen, og fortsettelsespunktet følger med umiddelbart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De knop Vanaf begin in de speler zet een film of aflevering terug naar het begin zonder het afspelen te verlaten, en je hervatpunt gaat meteen mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk Od początku w odtwarzaczu cofa film lub odcinek na sam początek bez opuszczania odtwarzania, a miejsce wznowienia od razu podąża za nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle Do início no player leva um filme ou episódio de volta ao começo sem sair da reprodução, e seu ponto de continuação acompanha na hora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controlo Do início no leitor leva um filme ou episódio de volta ao começo sem sair da reprodução, e o teu ponto de continuação acompanha de imediato."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comanda De la început din player readuce un film sau un episod la începutul lui fără să ieși din redare, iar punctul de reluare se mută imediat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка С начала в плеере возвращает фильм или эпизод к началу, не выходя из воспроизведения, а точка продолжения сразу следует за ней."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvok Od začiatku v prehrávači vráti film alebo epizódu na začiatok bez opustenia prehrávania a bod pokračovania sa hneď posunie s ním."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappen Från början i spelaren tar en film eller ett avsnitt tillbaka till starten utan att lämna uppspelningen, och din fortsättningspunkt följer direkt med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcıdaki Baştan denetimi, oynatmadan çıkmadan bir filmi veya bölümü başa alır ve kaldığınız yer hemen buna uyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка Спочатку в програвачі повертає фільм або епізод на початок, не виходячи з відтворення, а точка продовження одразу переходить разом з нею."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放器里的从头播放可以把影片或剧集拉回开头，不用退出播放，续播位置也会立刻跟着更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放器裡的從頭播放可以把影片或分集拉回開頭，不用退出播放，續看位置也會立刻跟著更新。"
          }
        }
      }
    },
