    "settings.playback.autoplayCountdown.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto zobrazí kartu bez odpočtu, takže titulky doběhnou před spuštěním další epizody."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra viser kortet uden nedtælling, så rulleteksterne kan køre færdigt før næste afsnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus zeigt die Karte ohne Timer, der Abspann läuft also zu Ende, bevor die nächste Folge startet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιημένο εμφανίζει την κάρτα χωρίς χρονόμετρο, ώστε να παίξουν οι τίτλοι τέλους πριν από το επόμενο επεισόδιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off shows the card without a timer, so credits play out before the next episode starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado muestra la tarjeta sin temporizador, así los créditos terminan antes del siguiente episodio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
