    "stats.watchTime.approxNote" : {
      "comment" : "Note that the watch time is an estimate.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhad podle délky a počtu přehrání. Včetně opakovaného sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimeret ud fra spilletid og antal afspilninger. Genvisninger medregnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzt aus Laufzeit und Wiedergabezahl. Wiederholungen eingerechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτίμηση από τη διάρκεια και τον αριθμό αναπαραγωγών. Περιλαμβάνονται οι επαναλήψεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated from runtime and play counts. Rewatches included."
          }
        },
