    "parental.profiles.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U každého profilu zvolte, zda je PIN potřeba k jeho otevření, nebo k odchodu z něj"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg for hver profil, om PIN-koden kræves for at åbne den eller for at forlade den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Profil festlegen, ob die PIN zum Öffnen oder zum Verlassen nötig ist"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ανά προφίλ αν χρειάζεται το PIN για να το ανοίξετε ή για να το εγκαταλείψετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose per profile whether the PIN is needed to open it, or to leave it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige en cada perfil si el PIN hace falta para abrirlo o para salir de él"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse profiilikohtaisesti, tarvitaanko PIN-koodi sen avaamiseen vai siitä poistumiseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez pour chaque profil si le code PIN est requis pour l'ouvrir ou pour le quitter"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za svaki profil odaberite je li PIN potreban za otvaranje ili za izlaz"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilonként add meg, hogy a PIN-kód a megnyitáshoz vagy a kilépéshez kell"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli per ogni profilo se il PIN serve per aprirlo o per uscirne"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルごとに、開くときにPINが必要か、出るときに必要かを選びます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필마다 PIN이 열 때 필요한지, 나갈 때 필요한지 선택하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg per profil om PIN-koden kreves for å åpne den eller for å forlate den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies per profiel of de pincode nodig is om het te openen of om het te verlaten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz dla każdego profilu, czy PIN jest potrzebny do jego otwarcia, czy do wyjścia z niego"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha em cada perfil se o PIN é necessário para abri-lo ou para sair dele"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha em cada perfil se o PIN é necessário para o abrir ou para sair dele"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege pentru fiecare profil dacă este nevoie de codul PIN ca să îl deschizi sau ca să îl părăsești"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для каждого профиля выберите, нужен ли PIN-код для входа в него или для выхода из него"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri každom profile zvoľte, či je PIN potrebný na jeho otvorenie alebo na odchod z neho"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj för varje profil om PIN-koden krävs för att öppna den eller för att lämna den"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her profil için PIN'in profili açmak mı yoksa profilden çıkmak için mi gerektiğini seçin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для кожного профілю виберіть, чи потрібен PIN-код для його відкриття, чи для виходу з нього"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个配置文件选择:打开时需要 PIN 码,还是离开时需要"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個設定檔選擇:開啟時需要 PIN 碼,還是離開時需要"
          }
        }
      }
    },
