    "player.error.streamRefused.body" : {
      "comment" : "Error body when the origin refused the stream request; %lld is the HTTP status",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server odmítl doručit tento stream (HTTP %lld). Položka nemusí být sdílená s tímto účtem nebo vypršelo přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste at levere dette stream (HTTP %lld). Elementet er måske ikke delt med denne konto, eller sessionen er udløbet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diesen Stream abgelehnt (HTTP %lld). Möglicherweise ist der Titel für dieses Konto nicht freigegeben oder die Sitzung ist abgelaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής αρνήθηκε να παραδώσει αυτή τη ροή (HTTP %lld). Το στοιχείο ίσως δεν είναι κοινόχρηστο με αυτόν τον λογαριασμό ή η συνεδρία έληξε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused to deliver this stream (HTTP %lld). The item may not be shared with this account, or the session may have expired."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó entregar esta transmisión (HTTP %lld). Puede que el elemento no esté compartido con esta cuenta o que la sesión haya caducado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin kieltäytyi toimittamasta tätä lähetystä (HTTP %lld). Kohdetta ei ehkä ole jaettu tälle tilille tai istunto on vanhentunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé de fournir ce flux (HTTP %lld). L'élément n'est peut-être pas partagé avec ce compte, ou la session a expiré."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj je odbio isporučiti ovaj stream (HTTP %lld). Stavka možda nije dijeljena s ovim računom ili je sesija istekla."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló elutasította a stream kiszolgálását (HTTP %lld). Lehet, hogy az elem nincs megosztva ezzel a fiókkal, vagy lejárt a munkamenet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato di fornire questo stream (HTTP %lld). L'elemento potrebbe non essere condiviso con questo account o la sessione è scaduta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこのストリームの配信を拒否しました (HTTP %lld)。このアカウントに共有されていないか、セッションの有効期限が切れている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이 스트림 전송을 거부했습니다 (HTTP %lld). 이 계정에 공유되지 않았거나 세션이 만료되었을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren nektet å levere denne strømmen (HTTP %lld). Elementet er kanskje ikke delt med denne kontoen, eller økten er utløpt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server weigerde deze stream te leveren (HTTP %lld). Mogelijk is het item niet gedeeld met dit account of is de sessie verlopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odmówił dostarczenia tego strumienia (HTTP %lld). Pozycja może nie być udostępniona temu kontu lub sesja wygasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou entregar esta transmissão (HTTP %lld). O item pode não estar compartilhado com esta conta ou a sessão expirou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou fornecer esta transmissão (HTTP %lld). O item pode não estar partilhado com esta conta ou a sessão expirou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverul a refuzat să livreze acest flux (HTTP %lld). Este posibil ca elementul să nu fie partajat cu acest cont sau ca sesiunea să fi expirat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отказался передавать этот поток (HTTP %lld). Возможно, элемент не открыт для этой учётной записи или сеанс истёк."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server odmietol doručiť tento stream (HTTP %lld). Položka nemusí byť zdieľaná s týmto účtom alebo vypršala relácia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern nekade att leverera den här strömmen (HTTP %lld). Objektet kanske inte är delat med det här kontot, eller så har sessionen gått ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
