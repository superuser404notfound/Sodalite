        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리를 검색하고, 카탈로그가 켜져 있으면 Jellyseerr도 검색합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søker i biblioteket ditt, og i Jellyseerr når Katalog er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorzoekt je bibliotheek, en Jellyseerr als Catalogus aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeszukuje twoją bibliotekę, a przy włączonym Katalogu także Jellyseerr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca na sua biblioteca e no Jellyseerr quando o Catálogo está ativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa na tua biblioteca e no Jellyseerr quando o Catálogo está ativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caută în biblioteca ta și în Jellyseerr când Catalog este activat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет в вашей библиотеке, а при включённом Каталоге и в Jellyseerr."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehľadá tvoju knižnicu a Jellyseerr, keď je Katalóg zapnutý."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker i ditt bibliotek, och i Jellyseerr när Katalog är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplığında arar, Katalog açıkken Jellyseerr'de de arar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукає у твоїй бібліотеці, а з увімкненим Каталогом і в Jellyseerr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索你的媒体库；目录开启时也搜索 Jellyseerr。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋你的媒體庫；目錄開啟時也搜尋 Jellyseerr。"
          }
        }
      }
    },
    "settings.tabs.music.subtitle" : {
      "comment" : "Row subtitle for the Music tab toggle",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvá hudební knihovna. Zobrazí se jen, pokud ji server má."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
