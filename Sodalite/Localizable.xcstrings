    "cloudSync.error.rejected" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud odmítl data tohoto zařízení. Jde o chybu v Sodalite, ne ve tvém zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud afviste denne enheds data. Det er en fejl i Sodalite, ikke på din enhed."
