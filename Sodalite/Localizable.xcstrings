    "settings.appearance.posterBadges.subtitle" : {
      "comment" : "Subtitle for the poster badges toggle",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí na kartách rozlišení, formát HDR a prostorový zvuk. Pro každou řadu načte další data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis opløsning, HDR-format og rumlig lyd på kortene. Henter ekstra data for hver række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auflösung, HDR-Format und räumlichen Ton auf den Karten anzeigen. Lädt dafür zusätzliche Daten pro Reihe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση ανάλυσης, μορφής HDR και χωρικού ήχου στις κάρτες. Φορτώνει επιπλέον δεδομένα για κάθε σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show resolution, HDR format and spatial audio on the cards. Loads extra data per row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la resolución, el formato HDR y el audio espacial en las tarjetas. Carga datos adicionales por fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä tarkkuus, HDR-muoto ja tilaääni korteissa. Lataa lisätietoja jokaista riviä kohden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la résolution, le format HDR et l'audio spatial sur les cartes. Charge des données supplémentaires pour chaque rangée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži razlučivost, HDR format i prostorni zvuk na karticama. Za svaki red učitava dodatne podatke."
          }
        },
        "hu" : {
