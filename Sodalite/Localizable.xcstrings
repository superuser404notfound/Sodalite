    "settings.appearance.libraryNames.subtitle" : {
      "comment" : "Subtitle for the library names toggle",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí název každé knihovny přes její obrázek v sekci Moje média. Nech vypnuté, pokud obrázky název už obsahují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner hvert biblioteks navn hen over dets billede i Mine medier. Lad det være slået fra, hvis billederne allerede viser navnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Namen jeder Bibliothek über ihr Bild in Meine Medien zeichnen. Aus lassen, wenn die Bilder den Namen schon tragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδιάζει το όνομα κάθε βιβλιοθήκης πάνω στην εικόνα της στην ενότητα «Τα πολυμέσα μου». Άφησέ το ανενεργό αν οι εικόνες δείχνουν ήδη το όνομα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw each library's name over its image in My Media. Leave it off if those images already show their name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el nombre de cada biblioteca sobre su imagen en Mi contenido. Déjalo desactivado si esas imágenes ya muestran el nombre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtää kunkin kirjaston nimen sen kuvan päälle Oma media -rivillä. Jätä pois päältä, jos kuvissa on nimi jo valmiina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le nom de chaque bibliothèque sur son image dans Ma médiathèque. Laisse désactivé si ces images portent déjà leur nom."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispisuje naziv svake biblioteke preko njezine slike u odjeljku Moji mediji. Ostavi isključeno ako slike već prikazuju naziv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Saját média sorban minden könyvtár nevét a képére rajzolja. Hagyd kikapcsolva, ha a képeken már szerepel a név."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive il nome di ogni libreria sulla sua immagine in I miei contenuti. Lascialo disattivato se quelle immagini mostrano già il nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「マイメディア」で各ライブラリの名前を画像の上に表示します。画像に名前が入っている場合はオフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 미디어에서 각 라이브러리 이름을 이미지 위에 표시합니다. 이미지에 이미 이름이 있으면 꺼 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner navnet på hvert bibliotek over bildet i Mine medier. La det være av hvis bildene allerede viser navnet."
          }
        },
        "nl" : {
          "stringUnit" : {
