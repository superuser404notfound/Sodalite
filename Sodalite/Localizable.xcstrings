    "changelog.0_4_1.atmosLabel.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos zvukové stopy se v rozbalovací nabídce zobrazují jako „Dolby Atmos“ místo pouhého počtu kanálů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-lydspor vises nu som \"Dolby Atmos\" i menuen i stedet for blot kanalantallet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-Tonspuren werden im Audio-Menü als „Dolby Atmos\" angezeigt statt nur als Kanalanzahl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κομμάτια ήχου Atmos εμφανίζονται πλέον ως «Dolby Atmos» στο μενού αντί για τον αριθμό καναλιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos audio tracks read \"Dolby Atmos\" in the dropdown instead of just the channel count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pistas Atmos aparecen como «Dolby Atmos» en el menú en lugar de solo el número de canales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-ääniraidat näkyvät valikossa nimellä \"Dolby Atmos\" pelkän kanavamäärän sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pistes audio Atmos affichent « Dolby Atmos » dans le menu plutôt que leur nombre de canaux."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos audio zapisi sada se prikazuju kao „Dolby Atmos“ umjesto samo broja kanala."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Atmos hangsávok „Dolby Atmos“ néven jelennek meg a menüben, nem csak a csatornaszámmal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tracce Atmos appaiono come «Dolby Atmos» nel menù invece del solo conteggio canali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmosオーディオトラックがチャンネル数ではなく「Dolby Atmos」とドロップダウンに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos 오디오 트랙이 채널 수 대신 드롭다운에 \"Dolby Atmos\"로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-lydspor vises nå som \"Dolby Atmos\" i menyen i stedet for bare kanalantallet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-audiotracks staan nu als \"Dolby Atmos\" in het menu in plaats van alleen het aantal kanalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżki audio Atmos są oznaczane „Dolby Atmos“ w menu zamiast samej liczby kanałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As faixas Atmos aparecem como \"Dolby Atmos\" no menu em vez de apenas a contagem de canais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As faixas Atmos aparecem como \"Dolby Atmos\" no menu em vez de apenas a contagem de canais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pistele audio Atmos apar ca „Dolby Atmos“ în meniu în loc de doar numărul de canale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дорожки Atmos в меню теперь отмечены как «Dolby Atmos», а не просто количеством каналов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos zvukové stopy sa v menu zobrazujú ako „Dolby Atmos“ namiesto počtu kanálov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos-ljudspår visas som \"Dolby Atmos\" i menyn istället för bara kanalantalet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos ses parçaları menüde kanal sayısı yerine \"Dolby Atmos\" olarak görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доріжки Atmos у меню тепер відображаються як «Dolby Atmos», а не лише кількістю каналів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos 音轨在下拉菜单中显示为\"Dolby Atmos\",而不仅是声道数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmos 音軌在下拉選單中顯示為「Dolby Atmos」,而不只是聲道數。"
          }
        }
      }
    },
