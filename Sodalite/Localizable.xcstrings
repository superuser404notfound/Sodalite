    "settings.profile.reprompt.detail" : {
      "comment" : "Explanation under the reprompt-interval picker",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptejte se, kdo se dívá, když se aplikace po čase vrátí z pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg hvem der ser, når appen vender tilbage efter et stykke tid i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Zurückkehren der App nach einer Weile im Hintergrund fragen, wer gerade schaut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρωτήστε ποιος παρακολουθεί όταν η εφαρμογή επιστρέφει από το παρασκήνιο μετά από κάποιο διάστημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask who's watching when the app comes back after time in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta quién está viendo cuando la app vuelve tras un tiempo en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy, kuka katselee, kun sovellus palaa taustalta jonkin ajan kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez qui regarde quand l'app revient après un moment en arrière-plan."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitajte tko gleda kad se aplikacija vrati iz pozadine nakon nekog vremena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezd meg, ki nézi, amikor az alkalmazás egy idő után visszatér a háttérből."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi chi sta guardando quando l'app torna dal background dopo un po' di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがしばらくバックグラウンドにあった後に復帰すると、視聴者を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 백그라운드에서 일정 시간을 보낸 후 돌아오면 시청자를 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør hvem som ser på når appen kommer tilbake fra bakgrunnen etter en stund."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag wie er kijkt wanneer de app terugkeert uit de achtergrond na een tijdje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj kto ogląda gdy aplikacja wróci z tła po pewnym czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte quem está assistindo quando o app voltar do segundo plano após um tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte quem está a ver quando a app regressar do segundo plano ao fim de algum tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întreabă cine se uită când aplicația revine din fundal după un timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте, кто смотрит, когда приложение возвращается из фона спустя некоторое время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opýtajte sa, kto sa pozerá, keď sa aplikácia po čase vráti z pozadia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga vem som tittar när appen återvänder från bakgrunden efter en stund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama arka planda bir süre kaldıktan sonra geri döndüğünde kimin izlediğini sor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запитуйте, хто дивиться, коли застосунок повертається з фону через деякий час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用在后台停留一段时间后恢复时，询问谁在观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式在背景停留一段時間後恢復時，詢問誰在觀看。"
          }
        }
      }
    },
