            "value" : "Toont de naam van elke bibliotheek over de afbeelding in Mijn media. Laat uit als die afbeeldingen de naam al tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla nazwę każdej biblioteki na jej obrazie w sekcji Moje multimedia. Zostaw wyłączone, jeśli obrazy już pokazują nazwę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha o nome de cada biblioteca sobre a imagem dela em Minha mídia. Deixe desativado se essas imagens já mostram o nome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
