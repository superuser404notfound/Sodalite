    "multiServer.addURL.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace vyzkouší obě adresy a připojí se přes tu, která odpoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
