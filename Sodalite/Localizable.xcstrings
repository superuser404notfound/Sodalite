    "changelog.1_0_0.topShelf.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračovat ve sledování a Další na domovské obrazovce Apple TV ukazují ve tvé barvě zvýraznění, jak daleko titul je, a výběrem se přehrávání spustí hned."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt med at se og Næste på Apple TV's hjemmeskærm viser i din accentfarve, hvor langt du er i en titel, og et valg starter afspilningen med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiterschauen und Als Nächstes auf dem Home-Bildschirm des Apple TV zeigen in deiner Akzentfarbe, wie weit ein Titel ist, und eine Auswahl startet die Wiedergabe sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Συνέχιση παρακολούθησης και το Επόμενο στην αρχική οθόνη του Apple TV δείχνουν στο χρώμα τονισμού σου πόσο έχει προχωρήσει ένας τίτλος, και η επιλογή ξεκινά αμέσως την αναπαραγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue Watching and Next Up on the Apple TV home screen show how far into a title you are, in your accent colour, and selecting one starts playback right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir viendo y Siguiente en la pantalla de inicio del Apple TV muestran con tu color de acento por dónde vas, y al elegir uno la reproducción empieza al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka katselua ja Seuraavaksi Apple TV:n aloitusnäytöllä näyttävät korostusvärilläsi, kuinka pitkällä nimike on, ja valinta käynnistää toiston heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer à regarder et À suivre sur l'écran d'accueil de l'Apple TV indiquent votre avancement dans votre couleur d'accent, et une sélection lance la lecture aussitôt."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi gledanje i Sljedeće na početnom zaslonu Apple TV-a u tvojoj boji naglaska pokazuju dokle si stigao, a odabir odmah pokreće reprodukciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Folytatás és a Következő az Apple TV kezdőképernyőjén a kiemelőszíneddel mutatja, hol tartasz, és a kiválasztás azonnal elindítja a lejátszást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a guardare e Prossimo nella schermata Home dell'Apple TV mostrano con il tuo colore d'accento a che punto sei, e selezionandone uno la riproduzione parte subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVのホーム画面の「視聴を続ける」と「次の再生」が、アクセントカラーで再生位置を示します。選ぶとすぐに再生が始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 홈 화면의 계속 시청과 다음 항목이 강조 색상으로 어디까지 봤는지 보여주고, 선택하면 바로 재생이 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å se og Neste på hjemmeskjermen til Apple TV viser i aksentfargen din hvor langt du er kommet, og et valg starter avspillingen med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verder kijken en Volgende op het beginscherm van de Apple TV laten in je accentkleur zien hoe ver je bent, en een keuze start het afspelen meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuuj oglądanie i Następne na ekranie głównym Apple TV pokazują w twoim kolorze akcentu, jak daleko jesteś, a wybór od razu uruchamia odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar assistindo e Próximo na tela de início do Apple TV mostram na sua cor de destaque em que ponto você está, e escolher um já começa a reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar a ver e A seguir no ecrã principal da Apple TV mostram na tua cor de destaque em que ponto estás, e escolher um inicia logo a reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuă vizionarea și Următorul de pe ecranul principal Apple TV arată în culoarea ta de accent unde ai rămas, iar selectarea pornește imediat redarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить просмотр и Далее на главном экране Apple TV показывают акцентным цветом, на чём вы остановились, а выбор сразу запускает воспроизведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračovať v sledovaní a Ďalšie na domovskej obrazovke Apple TV ukazujú v tvojej farbe zvýraznenia, kde si skončil, a výberom sa prehrávanie spustí hneď."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt titta och Nästa på Apple TV:s hemskärm visar i din accentfärg hur långt du har kommit, och ett val startar uppspelningen direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV ana ekranındaki İzlemeye Devam Et ve Sırada, vurgu renginizle nerede kaldığınızı gösterir; birini seçmek oynatmayı hemen başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продовжити перегляд і Наступне на головному екрані Apple TV показують акцентним кольором, де ви зупинилися, а вибір одразу запускає відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 主屏幕上的继续观看和接下来会用强调色标出看到哪里，选中即可立刻开始播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 主畫面上的繼續觀看和接下來會用強調色標出看到哪裡，選取即可立刻開始播放。"
          }
        }
      }
    },
