    "changelog.0_4_1.resumeButton.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko Přehrát v detailech ukazuje epizodu, časovou značku a indikátor postupu ve vaší akcentní barvě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil-knappen i detaljevisningen viser episode, tidsstempel og en fremgangsbjælke i din accentfarve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abspielen-Button in den Detailansichten zeigt Folge, Zeitstempel und einen Fortschrittsbalken in deiner Akzentfarbe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κουμπί αναπαραγωγής στις λεπτομέρειες δείχνει το επεισόδιο, τη χρονική σφραγίδα και μπάρα προόδου στο χρώμα έμφασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detail-view play button now shows the episode, timestamp, and a progress bar in your accent colour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón de reproducir en detalles muestra ahora el episodio, marca de tiempo y barra de progreso con tu color de acento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto­näkymän toistopainike näyttää nyt jakson, aikaleiman ja edistymispalkin korostusvärilläsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Lecture de la vue détail affiche désormais l'épisode, l'horodatage et une barre de progression dans votre couleur d'accent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumb Reproduciraj u detaljima sad prikazuje epizodu, vremenski žig i traku napretka u boji naglaska."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A részletek nézet lejátszás gombja most mutatja az epizódot, az időbélyeget és egy folyamatjelzőt a kiemelőszínedben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante Riproduci nella vista dettagli mostra ora l'episodio, il timestamp e una barra di avanzamento nel tuo colore d'accento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細画面の再生ボタンに、エピソード、タイムスタンプ、アクセントカラーの進捗バーが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세 화면의 재생 버튼이 이제 에피소드, 타임스탬프, 강조색의 진행률 바를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av-knappen i detaljvisningen viser nå episode, tidsstempel og en fremdriftsindikator i aksentfargen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De afspelen-knop in de detailweergave toont nu de aflevering, tijdstempel en een voortgangsbalk in jouw accentkleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk Odtwórz w widoku szczegółów pokazuje teraz odcinek, znacznik czasu i pasek postępu w Twoim kolorze akcentu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão Reproduzir nos detalhes agora mostra o episódio, o timestamp e uma barra de progresso na sua cor de destaque."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão Reproduzir nos detalhes mostra agora o episódio, o registo temporal e uma barra de progresso na sua cor de destaque."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butonul de redare în detalii afișează acum episodul, marca de timp și o bară de progres în culoarea ta de accent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка воспроизведения на экране деталей теперь показывает эпизод, метку времени и индикатор прогресса в вашем акцентном цвете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačidlo Prehrať v detailoch teraz ukazuje epizódu, časovú značku a indikátor postupu vo vašej akcentovej farbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela-knappen i detaljvyn visar nu avsnittet, tidsstämpeln och en förloppsindikator i din accentfärg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detay görünümündeki Oynat düğmesi artık bölümü, zaman damgasını ve vurgu renginizde bir ilerleme çubuğu gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка відтворення на екрані деталей тепер показує епізод, мітку часу та смугу прогресу у вашому акцентному кольорі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详情页的播放按钮现在显示剧集、时间戳以及您强调色的进度条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳情頁的播放按鈕現在顯示集數、時間戳以及您強調色的進度條。"
          }
        }
      }
    },
