    "changelog.1_0_0.clickToPause.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro televizní ovladače, které se k Apple TV dostanou přes HDMI-CEC a kde často projde jen Select: kliknutí hned pozastaví a zase spustí. Volitelné v Nastavení, Přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til tv-fjernbetjeninger, der når Apple TV via HDMI-CEC, hvor Vælg ofte er den eneste tast, der kommer igennem: et klik sætter straks på pause og fortsætter igen. Valgfrit under Indstillinger, Afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Fernbedienungen, die den Apple TV über HDMI-CEC erreichen und bei denen oft nur Select durchkommt: Ein Klick pausiert und setzt sofort fort. Optional unter Einstellungen, Wiedergabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για τηλεχειριστήρια τηλεόρασης που φτάνουν στο Apple TV μέσω HDMI-CEC, όπου συχνά περνά μόνο το Select: ένα κλικ κάνει αμέσως παύση και συνέχεια. Προαιρετικό, στις Ρυθμίσεις, Αναπαραγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For TV remotes that reach the Apple TV over HDMI-CEC, where Select is often the only key that gets through: a click pauses and resumes right away. Optional, in Settings, Playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mandos de televisor que llegan al Apple TV por HDMI-CEC, donde a menudo solo pasa Select: un clic pausa y reanuda al instante. Opcional, en Ajustes, Reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Television kaukosäätimille, jotka ohjaavat Apple TV:tä HDMI-CEC:n kautta ja joista usein menee läpi vain Select: napsautus keskeyttää ja jatkaa heti. Valinnainen kohdassa Asetukset, Toisto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les télécommandes de téléviseur qui pilotent l'Apple TV via HDMI-CEC, où seul Select passe souvent: un clic met en pause et relance aussitôt. Facultatif, dans Réglages, Lecture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za televizijske daljinske upravljače koji Apple TV dosežu preko HDMI-CEC-a, gdje često prolazi samo Select: klik odmah pauzira i nastavlja. Opcionalno u Postavkama, Reprodukcija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azokhoz a tévétávirányítókhoz, amelyek HDMI-CEC-en át érik el az Apple TV-t, és ahol gyakran csak a Select jut át: egy kattintás azonnal szüneteltet és folytat. Választható a Beállítások, Lejátszás alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i telecomandi TV che raggiungono l'Apple TV via HDMI-CEC, dove spesso passa solo Select: un clic mette in pausa e riprende subito. Opzionale, in Impostazioni, Riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDMI-CECでApple TVを操作するテレビのリモコンでは、通ってくるのがSelectだけということがよくあります。その場合でもクリックだけで一時停止と再開ができます。設定の再生からオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDMI-CEC로 Apple TV를 조작하는 TV 리모컨은 대개 Select만 전달됩니다. 이때 클릭 한 번으로 바로 일시정지하고 다시 재생할 수 있습니다. 설정의 재생에서 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For TV-fjernkontroller som når Apple TV via HDMI-CEC, der Select ofte er den eneste tasten som slipper gjennom: et klikk setter på pause og fortsetter med én gang. Valgfritt under Innstillinger, Avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor tv-afstandsbedieningen die de Apple TV via HDMI-CEC bedienen, waarbij vaak alleen Select doorkomt: een klik pauzeert en hervat meteen. Optioneel, in Instellingen, Afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla pilotów telewizyjnych sterujących Apple TV przez HDMI-CEC, gdzie często przechodzi tylko Select: kliknięcie od razu wstrzymuje i wznawia. Opcjonalnie w Ustawieniach, Odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para controles de TV que chegam ao Apple TV por HDMI-CEC, em que muitas vezes só o Select passa: um clique pausa e retoma na hora. Opcional, em Ajustes, Reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comandos de TV que chegam à Apple TV por HDMI-CEC, onde muitas vezes só o Select passa: um clique coloca em pausa e retoma de imediato. Opcional, em Definições, Reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru telecomenzile de televizor care ajung la Apple TV prin HDMI-CEC, unde adesea trece doar Select: un clic pune imediat pauză și reia. Opțional, în Setări, Redare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для телевизионных пультов, которые управляют Apple TV по HDMI-CEC, где часто проходит только Select: нажатие сразу ставит на паузу и снимает с неё. По желанию, в разделе Настройки, Воспроизведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre televízne ovládače, ktoré sa k Apple TV dostanú cez HDMI-CEC a kde často prejde len Select: kliknutie hneď pozastaví a znova spustí. Voliteľné v Nastaveniach, Prehrávanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För tv-fjärrkontroller som når Apple TV via HDMI-CEC, där Select ofta är den enda knappen som kommer fram: ett klick pausar och fortsätter direkt. Valfritt under Inställningar, Uppspelning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV'ye HDMI-CEC üzerinden ulaşan ve çoğu zaman yalnızca Select tuşunun geçtiği TV kumandaları için: tek tıklama hemen duraklatır ve sürdürür. İsteğe bağlı, Ayarlar, Oynatma altında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для телевізійних пультів, які керують Apple TV через HDMI-CEC, де часто проходить лише Select: натискання одразу ставить на паузу і знімає з неї. За бажанням, у розділі Параметри, Відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些电视遥控器通过 HDMI-CEC 控制 Apple TV，往往只有 Select 能传过来。开启后点按一下就能暂停和继续，在设置的播放里打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些電視遙控器透過 HDMI-CEC 控制 Apple TV，往往只有 Select 傳得過來。開啟後點按一下就能暫停和繼續，在設定的播放裡開啟。"
          }
        }
      }
    },
