    "changelog.1_0_0.personLibrary.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránka osobnosti teď začíná tím, co o ní má tvá vlastní knihovna: filmy, seriály a jednotlivé epizody s hostující rolí, nad úplnou filmografií. Bez Jellyseerru zůstane aspoň tato část, místo aby se stránka změnila v chybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En personside starter nu med det, dit eget bibliotek har med vedkommende: film, serier og de enkelte afsnit med gæsteoptræden, over den fulde filmografi. Uden Jellyseerr bliver den del stående i stedet for en fejlmeddelelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Personenseite zeigt jetzt zuerst, was deine eigene Bibliothek von ihr hat: Filme, Serien und die einzelnen Folgen mit Gastauftritt, über der vollständigen Filmografie. Ohne Jellyseerr bleibt dieser Teil erhalten, statt dass die Seite zur Fehlermeldung wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σελίδα ενός προσώπου ξεκινά πλέον με όσα έχει η δική σου βιβλιοθήκη: ταινίες, σειρές και τα μεμονωμένα επεισόδια όπου εμφανίζεται, πάνω από την πλήρη φιλμογραφία. Χωρίς το Jellyseerr αυτό το μέρος παραμένει, αντί για μήνυμα σφάλματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A person page now opens with what your own library holds for them, movies, series and the single episodes they guest in, above the full filmography. Without Jellyseerr that half stays instead of the page turning into an error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página de una persona ahora empieza por lo que tiene tu propia biblioteca: películas, series y los episodios sueltos en los que aparece, encima de la filmografía completa. Sin Jellyseerr esa parte se mantiene en lugar de convertirse en un error."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilösivu alkaa nyt sillä, mitä oma kirjastosi hänestä sisältää: elokuvat, sarjat ja yksittäiset vierailujaksot, koko filmografian yläpuolella. Ilman Jellyseerriä tämä osa jää näkyviin virheilmoituksen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page d'une personne commence désormais par ce que ta propre bibliothèque possède d'elle: films, séries et les épisodes isolés où elle apparaît, au-dessus de la filmographie complète. Sans Jellyseerr, cette partie reste au lieu d'une page d'erreur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stranica osobe sada počinje onim što o njoj ima tvoja biblioteka: filmovi, serije i pojedine epizode s gostujućom ulogom, iznad cijele filmografije. Bez Jellyseerra taj dio ostaje umjesto poruke o pogrešci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A személy oldala mostantól azzal kezdődik, ami a saját könyvtáradban van tőle: filmek, sorozatok és az egyes epizódok, amelyekben feltűnik, a teljes filmográfia fölött. Jellyseerr nélkül ez a rész megmarad hibaüzenet helyett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina di una persona ora si apre con quello che la tua libreria ha di lei: film, serie e i singoli episodi in cui compare, sopra la filmografia completa. Senza Jellyseerr questa parte resta, invece di una pagina di errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人物ページは、まず自分のライブラリにあるもの、映画、番組、ゲスト出演した単話を表示し、その下に全フィルモグラフィーが並びます。Jellyseerr がなくてもこの部分は残り、エラー画面にはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인물 페이지가 이제 내 라이브러리에 있는 항목부터 보여줍니다. 영화, 시리즈, 그리고 게스트로 출연한 개별 에피소드가 전체 필모그래피 위에 표시됩니다. Jellyseerr가 없어도 이 부분은 그대로 남고 오류 화면이 되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En personside starter nå med det ditt eget bibliotek har: filmer, serier og de enkelte episodene med gjesteopptreden, over hele filmografien. Uten Jellyseerr blir denne delen stående i stedet for en feilmelding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een personenpagina begint nu met wat je eigen bibliotheek van diegene heeft: films, series en de losse afleveringen met een gastrol, boven de volledige filmografie. Zonder Jellyseerr blijft dat deel staan in plaats van een foutmelding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strona osoby zaczyna się teraz od tego, co ma twoja własna biblioteka: filmy, seriale i pojedyncze odcinki z gościnnym udziałem, nad pełną filmografią. Bez Jellyseerra ta część zostaje, zamiast komunikatu o błędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página de uma pessoa agora começa pelo que a sua própria biblioteca tem dela: filmes, séries e os episódios avulsos em que aparece, acima da filmografia completa. Sem o Jellyseerr essa parte continua, em vez de a página virar um erro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página de uma pessoa começa agora pelo que a tua própria biblioteca tem dela: filmes, séries e os episódios avulsos em que aparece, acima da filmografia completa. Sem o Jellyseerr essa parte mantém-se, em vez de a página se tornar um erro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina unei persoane începe acum cu ce are propria ta bibliotecă despre ea: filme, seriale și episoadele individuale în care apare, deasupra filmografiei complete. Fără Jellyseerr partea aceasta rămâne, în loc de un mesaj de eroare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница персоны теперь начинается с того, что есть в твоей библиотеке: фильмы, сериалы и отдельные серии с её участием, над полной фильмографией. Без Jellyseerr эта часть остаётся, а не превращается в ошибку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránka osobnosti sa teraz začína tým, čo o nej má tvoja knižnica: filmy, seriály a jednotlivé epizódy s hosťujúcou úlohou, nad úplnou filmografiou. Bez Jellyseerru táto časť zostane namiesto chybovej hlášky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En personsida börjar nu med det ditt eget bibliotek har: filmer, serier och de enskilda avsnitt personen gästar i, ovanför hela filmografin. Utan Jellyseerr blir den delen kvar i stället för ett felmeddelande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişi sayfası artık önce kendi kitaplığında olanları gösteriyor: filmler, diziler ve konuk olarak yer aldığı tek bölümler, tam filmografinin üstünde. Jellyseerr olmadan bu bölüm kalıyor, sayfa hata ekranına dönüşmüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сторінка персони тепер починається з того, що є у твоїй бібліотеці: фільми, серіали та окремі епізоди з її участю, над повною фільмографією. Без Jellyseerr ця частина лишається, а не перетворюється на помилку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人物页面现在先显示你自己媒体库里的内容：电影、剧集，以及客串的单集，然后才是完整作品列表。没有 Jellyseerr 时这部分依然保留，不会变成错误页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人物頁面現在會先顯示你自己媒體庫裡的內容：電影、影集，以及客串的單集，接著才是完整作品列表。沒有 Jellyseerr 時這部分依然保留，不會變成錯誤頁面。"
          }
        }
      }
    },
    "changelog.1_0_0.pip.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmenši přehrávání do rohu přímo z ovládacího panelu, u videa i u živé TV, a procházej dál. Na iPhonu a iPadu to teď funguje i u softwarově dekódovaných titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krymp afspilningen ned i et hjørne fra betjeningslinjen, både for video og live-tv, og bliv ved med at browse. På iPhone og iPad virker det nu også for softwaredekodede titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkleinere die Wiedergabe über die Transportleiste in eine Ecke, für Video und Live-TV, und stöbere weiter. Auf iPhone und iPad klappt das jetzt auch bei softwaredekodierten Titeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σμίκρυνε την αναπαραγωγή σε μια γωνία από τη γραμμή αναπαραγωγής, για βίντεο και ζωντανή τηλεόραση, και συνέχισε την περιήγηση. Σε iPhone και iPad λειτουργεί πλέον και για τίτλους με αποκωδικοποίηση λογισμικού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrink playback into a corner from the transport bar, for video and for live TV, and keep browsing. On iPhone and iPad it now works for software-decoded titles too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce la reproducción a una esquina desde la barra de reproducción, para vídeo y TV en directo, y sigue navegando. En iPhone y iPad ahora también funciona con títulos descodificados por software."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutista toisto kulmaan toistopalkista, sekä videolle että suoralle TV:lle, ja jatka selaamista. iPhonella ja iPadilla se toimii nyt myös ohjelmistopohjaisesti puretuille nimikkeille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduisez la lecture dans un coin depuis la barre de lecture, pour la vidéo et la TV en direct, et continuez à parcourir. Sur iPhone et iPad, cela fonctionne désormais aussi pour les titres décodés par logiciel."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smanji reprodukciju u kut iz trake za reprodukciju, za video i TV uživo, i nastavi pregledavati. Na iPhoneu i iPadu sada radi i za softverski dekodirane naslove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kicsinyítsd a lejátszást a sarokba a vezérlősávból, videóhoz és élő TV-hez, és böngéssz tovább. iPhone-on és iPaden már a szoftveresen dekódolt címeknél is működik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci la riproduzione in un angolo dalla barra di riproduzione, per i video e per la TV in diretta, e continua a sfogliare. Su iPhone e iPad ora funziona anche per i titoli decodificati via software."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生バーからビデオもライブTVも画面の隅に縮小して、そのまま閲覧を続けられます。iPhoneとiPadではソフトウェアデコードの作品にも対応しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 바에서 비디오와 실시간 TV를 화면 구석으로 줄이고 계속 둘러보세요. iPhone과 iPad에서는 이제 소프트웨어로 디코딩되는 작품도 지원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krymp avspillingen ned i et hjørne fra kontrollinjen, for video og direkte-TV, og fortsett å bla. På iPhone og iPad virker det nå også for programvaredekodede titler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verklein het afspelen vanaf de afspeelbalk naar een hoek, voor video en live-tv, en blijf bladeren. Op iPhone en iPad werkt het nu ook voor softwarematig gedecodeerde titels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsz odtwarzanie do rogu z paska odtwarzania, dla wideo i TV na żywo, i przeglądaj dalej. Na iPhonie i iPadzie działa to teraz także dla tytułów dekodowanych programowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduza a reprodução para um canto pela barra de reprodução, para vídeo e TV ao vivo, e continue navegando. No iPhone e iPad agora também funciona com títulos decodificados por software."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz a reprodução para um canto a partir da barra de reprodução, para vídeo e TV em direto, e continua a navegar. No iPhone e iPad funciona agora também com títulos descodificados por software."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micșorează redarea într-un colț din bara de redare, pentru video și pentru TV live, și continuă să navighezi. Pe iPhone și iPad funcționează acum și pentru titlurile decodate software."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшите воспроизведение в угол прямо с панели воспроизведения, для видео и для эфирного ТВ, и продолжайте листать. На iPhone и iPad это теперь работает и для программно декодируемых файлов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmenši prehrávanie do rohu z ovládacieho panela, pre video aj živú TV, a prehliadaj ďalej. Na iPhone a iPade to teraz funguje aj pri softvérovo dekódovaných tituloch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krymp uppspelningen till ett hörn från kontrollraden, för video och live-tv, och fortsätt bläddra. På iPhone och iPad fungerar det nu även för programvaruavkodade titlar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatmayı oynatma çubuğundan bir köşeye küçültün, hem video hem canlı TV için, ve gezinmeye devam edin. iPhone ve iPad'de artık yazılımla çözülen içeriklerde de çalışıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшуйте відтворення в куток прямо з панелі відтворення, для відео та ефірного ТБ, і гортайте далі. На iPhone та iPad це тепер працює й для програмно декодованих файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从播放控制条把播放缩到角落，视频和直播电视都支持，同时继续浏览。在 iPhone 和 iPad 上现在也支持软件解码的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從播放控制列把播放縮到角落，影片和直播電視都支援，同時繼續瀏覽。在 iPhone 和 iPad 上現在也支援軟體解碼的內容。"
          }
        }
      }
    },
