    "player.error.rateLimited.body" : {
      "comment" : "Error body when the origin is metering us; the source is not gone, so the copy asks for patience",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj právě nepřijímá další připojení, obvykle proto, že z něj už streamuje jiné zařízení. Chvíli počkejte a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilden accepterer ikke flere forbindelser lige nu, typisk fordi en anden enhed allerede streamer fra den. Vent et øjeblik, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle nimmt gerade keine weitere Verbindung an, meist weil bereits ein anderes Gerät von ihr streamt. Einen Moment warten und erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πηγή δεν δέχεται αυτή τη στιγμή άλλη σύνδεση, συνήθως επειδή μια άλλη συσκευή ήδη κάνει ροή από αυτήν. Περιμένετε λίγο και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source is not accepting another connection right now, usually because another device is already streaming from it. Wait a moment before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente no acepta otra conexión en este momento, normalmente porque otro dispositivo ya está reproduciendo desde ella. Espera un momento y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähde ei ota vastaan uutta yhteyttä juuri nyt, yleensä siksi että toinen laite jo suoratoistaa siitä. Odota hetki ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source n'accepte pas d'autre connexion pour le moment, généralement parce qu'un autre appareil diffuse déjà depuis elle. Patientez un instant avant de réessayer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvor trenutačno ne prihvaća još jednu vezu, obično zato što s njega već streama drugi uređaj. Pričekajte trenutak pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forrás jelenleg nem fogad újabb kapcsolatot, általában azért, mert egy másik eszköz már közvetít róla. Várjon egy pillanatot, majd próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sorgente non accetta un'altra connessione al momento, di solito perché un altro dispositivo sta già riproducendo da essa. Attendi un momento e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースは現在、これ以上の接続を受け付けていません。通常は別のデバイスがすでに再生しているためです。少し待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스가 현재 추가 연결을 받지 않습니다. 보통 다른 기기가 이미 스트리밍 중이기 때문입니다. 잠시 기다린 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilden tar ikke imot flere tilkoblinger nå, som regel fordi en annen enhet allerede strømmer fra den. Vent et øyeblikk og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bron accepteert op dit moment geen extra verbinding, meestal omdat een ander apparaat er al van streamt. Wacht even en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło nie przyjmuje teraz kolejnego połączenia, zwykle dlatego, że inne urządzenie już z niego strumieniuje. Odczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte não está aceitando outra conexão agora, geralmente porque outro dispositivo já está transmitindo dela. Aguarde um momento e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte não está a aceitar outra ligação neste momento, normalmente porque outro dispositivo já está a transmitir a partir dela. Aguarde um momento e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sursa nu acceptă altă conexiune momentan, de obicei pentru că un alt dispozitiv redă deja din ea. Așteptați un moment și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник сейчас не принимает новое подключение, обычно потому что с него уже вещает другое устройство. Подождите немного и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj momentálne neprijíma ďalšie pripojenie, zvyčajne preto, že z neho už streamuje iné zariadenie. Chvíľu počkajte a skúste to znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källan tar inte emot fler anslutningar just nu, oftast för att en annan enhet redan strömmar från den. Vänta en stund och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynak şu anda başka bir bağlantı kabul etmiyor, genellikle başka bir cihaz zaten yayın aldığı için. Biraz bekleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джерело зараз не приймає ще одне підключення, зазвичай тому, що з нього вже транслює інший пристрій. Зачекайте трохи й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源目前不接受更多连接，通常是因为已有另一台设备正在从中播放。请稍等片刻后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來源目前不接受更多連線，通常是因為已有另一台裝置正在從中播放。請稍候片刻再試。"
          }
        }
      }
    },
