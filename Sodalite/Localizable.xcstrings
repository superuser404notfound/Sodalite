    "settings.playback.subtitlesOnSkipBack.subtitle" : {
      "comment" : "Subtitle for the subtitlesOnSkipBack preference",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po skoku zpět krátce zobrazí titulky, dokud se přehrávání nevrátí na původní místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser kortvarigt undertekster efter et spring tilbage, indtil afspilningen har indhentet det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nach einem Sprung zurück kurz Untertitel, bis die Wiedergabe wieder aufgeholt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει σύντομα υπότιτλους μετά από μετάβαση πίσω, μέχρι η αναπαραγωγή να φτάσει ξανά στο ίδιο σημείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefly show subtitles after skipping back, until playback catches up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra brevemente los subtítulos tras retroceder, hasta que la reproducción vuelva al punto anterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää tekstityksen hetken taaksepäin siirtymisen jälkeen, kunnes toisto saavuttaa lähtökohdan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche brièvement les sous-titres après un retour arrière, jusqu'à ce que la lecture rattrape le point de départ."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakratko prikazuje titlove nakon skoka unatrag, dok reprodukcija ne dostigne polazište."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaugrás után rövid ideig megjeleníti a feliratokat, amíg a lejátszás utol nem éri a kiindulási pontot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra brevemente i sottotitoli dopo un salto indietro, finché la riproduzione non torna al punto di partenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップバック後、再生が元の位置に追いつくまで字幕を一時的に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뒤로 건너뛴 후 재생이 원래 위치를 따라잡을 때까지 자막을 잠시 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser undertekster en kort stund etter et hopp bakover, til avspillingen har tatt igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont kort ondertiteling na het terugspringen, totdat het afspelen weer is bijgelopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po skoku wstecz na chwilę pokazuje napisy, dopóki odtwarzanie nie nadrobi dystansu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as legendas brevemente após voltar, até a reprodução recuperar o ponto anterior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
