    "support.header.copy" : {
      "comment" : "Main explainer paragraph on the Support Development screen",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite je projekt jednoho člověka, který vzniká z nadšení. Veškeré funkce aplikace jsou a zůstanou zdarma. Spropitné a placené kosmetické doplňky v Balíčku podporovatele jsou volitelné. Pomáhají pokrýt poplatek Apple Developer a ukazují, že si této práce vážíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite er et passionprojekt lavet af én person. Alle appens funktioner er og forbliver gratis. Drikkepenge og de betalte kosmetiske tilvalg i Supporter-pakken er valgfrie. De hjælper med at dække Apple Developer-gebyret og viser, at arbejdet værdsættes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ist ein Ein-Personen-Projekt aus Leidenschaft. Alle Funktionen der App sind und bleiben kostenlos. Trinkgelder und die kostenpflichtigen kosmetischen Extras des Supporter-Pakets sind optional. Sie helfen, die Apple-Developer-Gebühr zu decken, und zeigen, dass die Arbeit geschätzt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sodalite είναι ένα προσωπικό έργο φτιαγμένο με μεράκι από έναν άνθρωπο. Όλες οι λειτουργίες της εφαρμογής είναι και θα παραμείνουν δωρεάν. Τα φιλοδωρήματα και τα επί πληρωμή αισθητικά πρόσθετα του Πακέτου Υποστήριξης είναι προαιρετικά. Βοηθούν να καλυφθεί η συνδρομή Apple Developer και δείχνουν ότι η δουλειά εκτιμάται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite is a one-person passion project. Every functional feature in the app is and stays free. Tips and the paid cosmetic Supporter Pack are optional. They help cover the Apple Developer fee and show that the work is appreciated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite es un proyecto personal creado con pasión por una sola persona. Todas las funciones de la app son y seguirán siendo gratuitas. Las propinas y los extras cosméticos de pago del Pack de Apoyo son opcionales. Ayudan a cubrir la cuota de Apple Developer y muestran que se aprecia el trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite on yhden henkilön intohimoprojekti. Kaikki sovelluksen toiminnalliset ominaisuudet ovat ja pysyvät ilmaisina. Juomarahat ja Tukijapaketin maksulliset ulkoasulisät ovat valinnaisia. Ne auttavat kattamaan Apple Developer -maksun ja osoittavat, että työtä arvostetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite est un projet personnel porté avec passion par une seule personne. Toutes les fonctionnalités de l’application sont et resteront gratuites. Les pourboires et les options esthétiques payantes du Pack de soutien sont facultatifs. Ils aident à couvrir les frais Apple Developer et montrent que le travail est apprécié."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite je projekt jedne osobe nastao iz strasti. Sve funkcionalne značajke aplikacije jesu i ostat će besplatne. Napojnice i estetski dodaci Podržavateljskog paketa koji se plaćaju su opcionalni. Pomažu pokriti naknadu Apple Developer i pokazuju da se rad cijeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sodalite egyszemélyes szenvedélyprojekt. Az alkalmazás minden funkciója ingyenes, és az is marad. A borravalók és a Támogatói csomag fizetős megjelenési extrái opcionálisak. Segítenek fedezni az Apple Developer díjat és mutatják, hogy a munkát megbecsülik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite è un progetto personale nato dalla passione di una sola persona. Tutte le funzionalità dell’app sono e resteranno gratuite. Le mance e gli extra estetici a pagamento del Pacchetto Sostenitore sono opzionali. Aiutano a coprire la quota Apple Developer e mostrano che il lavoro è apprezzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodaliteは一人で作っている情熱プロジェクトです。アプリの機能はすべて無料のままで、チップとサポーターパックの有料外観カスタマイズは任意です。Apple Developerの登録料をまかない、開発への応援を示す助けになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite는 한 사람의 열정 프로젝트입니다. 앱의 모든 기능은 무료이며 앞으로도 무료로 유지됩니다. 팁과 서포터 팩의 유료 꾸미기 옵션은 선택 사항입니다. Apple Developer 수수료를 충당하고 개발에 대한 응원을 표현하는 데 도움이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite er et lidenskapsprosjekt laget av én person. Alle appens funksjoner er og forblir gratis. Drikkepenger og de betalte kosmetiske tilleggene i Supporter-pakken er valgfrie. De hjelper med å dekke Apple Developer-avgiften og viser at arbeidet settes pris på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite is een passieproject van één persoon. Alle functies van de app zijn en blijven gratis. Fooien en de betaalde cosmetische extra’s van het Supporterspakket zijn optioneel. Ze helpen de Apple Developer-vergoeding te dekken en laten zien dat het werk gewaardeerd wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite to projekt pasji jednej osoby. Wszystkie funkcje aplikacji są i pozostaną bezpłatne. Napiwki i płatne dodatki kosmetyczne Pakietu Wspierającego są opcjonalne. Pomagają pokryć opłatę Apple Developer i pokazują, że praca jest doceniana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite é um projeto pessoal feito com paixão por uma só pessoa. Todos os recursos funcionais do app são e continuarão gratuitos. Gorjetas e os extras visuais pagos do Pacote de Apoio são opcionais. Eles ajudam a cobrir a taxa do Apple Developer e mostram que o trabalho é apreciado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite é um projeto pessoal feito com paixão por uma só pessoa. Todas as funcionalidades da app são e continuarão gratuitas. Gorjetas e os extras visuais pagos do Pacote de Apoio são opcionais. Ajudam a cobrir a taxa do Apple Developer e mostram que o trabalho é apreciado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite este proiectul de suflet al unei singure persoane. Toate funcțiile aplicației sunt și vor rămâne gratuite. Bacșișurile și elementele cosmetice contra cost ale Pachetului de Susținător sunt opționale. Ajută la acoperirea taxei Apple Developer și arată că munca este apreciată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite представляет собой личный проект, который один человек создаёт с увлечением. Все функциональные возможности приложения бесплатны и останутся такими. Чаевые и платные косметические дополнения Пакета поддержки необязательны. Они помогают покрыть плату Apple Developer и показывают, что работа ценится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite je projekt jedného človeka, ktorý vznikol z nadšenia. Všetky funkcie aplikácie sú a zostanú zadarmo. Prepitné a platené vzhľadové doplnky Balíčka podporovateľa sú voliteľné. Pomáhajú pokryť poplatok Apple Developer a ukazujú, že práca je cenená."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite är ett passionsprojekt av en enda person. Alla funktioner i appen är och förblir gratis. Dricks och de betalda kosmetiska tillvalen i Supporterpaketet är frivilliga. De hjälper till att täcka Apple Developer-avgiften och visar att arbetet uppskattas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite tek kişinin tutku projesidir. Uygulamanın tüm işlevsel özellikleri ücretsizdir ve öyle kalacaktır. Bahşişler ve Destekçi Paketi’ndeki ücretli kozmetik ekstralar isteğe bağlıdır. Apple Developer ücretini karşılamaya yardımcı olur ve çalışmanın takdir edildiğini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite є особистим проєктом, який одна людина створює із захопленням. Усі функціональні можливості застосунку безкоштовні й такими залишаться. Чайові та платні косметичні доповнення Пакета прихильника необов’язкові. Вони допомагають покрити плату Apple Developer і показують, що роботу цінують."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite 是由一人用热情打造的项目。应用的所有功能均免费且将始终免费。小费和支持者套餐中的付费外观选项完全自愿。它们有助于支付 Apple Developer 费用，也表达了对开发工作的认可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite 是由一人用熱情打造的專案。應用程式的所有功能均免費且將始終免費。小費和支持者套裝中的付費外觀選項完全自願。它們有助於支付 Apple Developer 費用，也表達了對開發工作的肯定。"
          }
        }
      }
    },
