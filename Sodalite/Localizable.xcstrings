        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyseerr'de gezinme ve istekler. Kapalıyken katalog sonuçları Ara sekmesinde ve kişi sayfalarında da gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
