    "settings.appearance.spoiler.subtitle" : {
      "comment" : "Subtitle for the spoiler protection toggle",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozostří popisy a obrázky epizod, dokud titul nezhlédnete nebo nezačnete přehrávat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slører beskrivelser og episodebilleder, indtil du har set eller påbegyndt en titel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibungen und Episodenbilder bleiben unscharf, bis ein Titel gesehen oder begonnen wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θολώνει τις περιγραφές και τις εικόνες επεισοδίων μέχρι να δείτε ή να ξεκινήσετε έναν τίτλο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur descriptions and episode images until you have watched or started a title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina las descripciones y las imágenes de episodios hasta que hayas visto o empezado un título."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumentaa kuvaukset ja jaksokuvat, kunnes olet katsonut tai aloittanut nimikkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute les descriptions et les images d'épisodes jusqu'à ce qu'un titre soit vu ou commencé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamućuje opise i slike epizoda dok naslov ne pogledate ili ne započnete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elhomályosítja a leírásokat és az epizódképeket, amíg meg nem nézed vagy el nem kezded a címet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoca descrizioni e immagini degli episodi finché non hai visto o iniziato un titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴済みまたは再生開始までは、あらすじとエピソード画像をぼかします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청했거나 재생을 시작하기 전까지 설명과 에피소드 이미지를 흐리게 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør beskrivelser og episodebilder uskarpe til du har sett eller startet en tittel."
          }
        },
        "nl" : {
          "stringUnit" : {
