    "changelog.1_0_0.favorites.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srdíčko teď funguje i u jedné epizody a ty dostanou na úvodní obrazovce vlastní řádek Oblíbené epizody, vedle Oblíbených pro všechno ostatní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertet virker nu også på et enkelt afsnit, og de får deres egen række Favoritafsnit på forsiden, ved siden af Favoritter for alt andet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Herz funktioniert jetzt auch bei einer einzelnen Folge, und die bekommen auf der Startseite ihre eigene Zeile Lieblingsfolgen, neben den Favoriten für alles andere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρδιά λειτουργεί πλέον και σε ένα μόνο επεισόδιο, και αυτά αποκτούν δική τους σειρά Αγαπημένα επεισόδια στην αρχική, δίπλα στα Αγαπημένα για όλα τα υπόλοιπα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A heart now works on a single episode too, and those get their own Favorite Episodes row on Home, next to Favorites for everything else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El corazón ahora también funciona en un episodio suelto, y esos tienen su propia fila Episodios favoritos en el inicio, junto a Favoritos para todo lo demás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydän toimii nyt myös yksittäiselle jaksolle, ja ne saavat aloitusnäytölle oman Suosikkijaksot-rivin, Suosikkien viereen kaikelle muulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cœur fonctionne désormais aussi sur un seul épisode, et ceux-ci ont leur propre rangée Épisodes favoris sur l'accueil, à côté de Favoris pour tout le reste."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srce sada radi i na pojedinoj epizodi, a one dobivaju vlastiti redak Omiljene epizode na početnom zaslonu, uz Favorite za sve ostalo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szív már egyetlen epizódnál is működik, és ezek külön Kedvenc epizódok sort kapnak a kezdőképernyőn, a Kedvencek mellett minden máshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cuore ora funziona anche su un singolo episodio, e questi hanno una riga Episodi preferiti tutta loro nella schermata iniziale, accanto ai Preferiti per tutto il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハートは1話単位でも使えるようになり、ホームには「お気に入りのエピソード」の行が加わります。ほかはこれまでどおりお気に入りの行にまとまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하트를 에피소드 하나에도 표시할 수 있고, 홈에 즐겨찾는 에피소드 줄이 따로 생깁니다. 나머지는 그대로 즐겨찾기 줄에 모입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjertet virker nå også på en enkelt episode, og de får sin egen rad Favorittepisoder på startsiden, ved siden av Favoritter for alt annet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hartje werkt nu ook op één aflevering, en die krijgen een eigen rij Favoriete afleveringen op het startscherm, naast Favorieten voor al het andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serce działa teraz również na pojedynczym odcinku, a te trafiają na ekranie głównym do własnego wiersza Ulubione odcinki, obok Ulubionych dla całej reszty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O coração agora funciona também em um episódio avulso, e eles ganham a própria fileira Episódios favoritos na tela inicial, ao lado de Favoritos para todo o resto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O coração funciona agora também num episódio individual, e estes ganham a sua própria fila Episódios favoritos no início, ao lado de Favoritos para tudo o resto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inima funcționează acum și pentru un singur episod, iar acestea primesc propriul rând Episoade favorite pe ecranul principal, lângă Favorite pentru tot restul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сердечко теперь работает и для одного эпизода, а такие эпизоды получают на главном экране собственный ряд Избранные эпизоды, рядом с Избранным для всего остального."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srdce teraz funguje aj pri jednej epizóde a tie dostanú na úvodnej obrazovke vlastný riadok Obľúbené epizódy, vedľa Obľúbených pre všetko ostatné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjärtat fungerar nu även på ett enskilt avsnitt, och de får en egen rad Favoritavsnitt på startsidan, bredvid Favoriter för allt annat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalp artık tek bir bölümde de çalışıyor ve bunlar ana ekranda kendi Favori Bölümler satırını alıyor; geri kalan her şey Favoriler satırında kalıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сердечко тепер працює й для окремого епізоду, а такі епізоди отримують на головному екрані власний ряд Улюблені епізоди, поруч з Улюбленим для решти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱心现在也能标在单集上，主页会多出一行收藏的剧集，其余内容仍留在收藏行里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛心現在也能標在單集上，首頁會多出一行最愛的劇集，其餘內容仍留在最愛那一行。"
          }
        }
      }
    },
