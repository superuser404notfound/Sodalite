    "player.error.engineClassified.body" : {
      "comment" : "Engine typed the failure but the host has no sentence for that kind; %@ is the stable kind + code token",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávač nemohl pokračovat v přehrávání tohoto videa. Pokud se to opakuje, uveďte v hlášení chyby tento kód: %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilleren kunne ikke fortsætte med denne video. Hvis det bliver ved, så tag denne kode med i en fejlrapport: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe dieses Videos konnte nicht fortgesetzt werden. Falls das häufiger passiert, diesen Code in eine Fehlermeldung aufnehmen: %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναπαραγωγή αυτού του βίντεο δεν μπόρεσε να συνεχιστεί. Αν επαναληφθεί, συμπεριλάβετε αυτόν τον κωδικό σε αναφορά σφάλματος: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player could not continue with this video. If it keeps happening, include this code in a bug report: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reproductor no pudo continuar con este vídeo. Si vuelve a ocurrir, incluye este código en un informe de error: %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisto ei voinut jatkua tällä videolla. Jos ongelma toistuu, liitä tämä koodi virheraporttiin: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture de cette vidéo n'a pas pu se poursuivre. Si cela se reproduit, indiquez ce code dans un rapport de bogue : %@"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodukcija ovog videozapisa nije se mogla nastaviti. Ako se ponovi, navedite ovaj kôd u prijavi greške: %@"
          }
        },
