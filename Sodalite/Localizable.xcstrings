    "localNetwork.denied.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nemůže kontaktovat servery ve vaší síti, protože toto zařízení blokuje přístup k místní síti. Ostatních aplikací ani Safari se to netýká, a proto to vypadá jako přerušené připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite kan ikke nå servere på dit netværk, fordi denne enhed blokerer adgang til det lokale netværk. Andre apps og Safari er upåvirkede, og derfor ligner det en afbrudt forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite erreicht keine Server in deinem Netzwerk, weil dieses Gerät den Zugriff auf das lokale Netzwerk blockiert. Andere Apps und Safari sind nicht betroffen, deshalb sieht es wie eine gestörte Verbindung aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sodalite δεν μπορεί να προσεγγίσει διακομιστές στο δίκτυό σας, επειδή αυτή η συσκευή αποκλείει την πρόσβαση στο τοπικό δίκτυο. Οι άλλες εφαρμογές και το Safari δεν επηρεάζονται, γι' αυτό μοιάζει με προβληματική σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite cannot reach servers on your network because this device is blocking local network access. Other apps and Safari are unaffected, which is why this looks like a broken connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite no puede contactar con los servidores de tu red porque este dispositivo bloquea el acceso a la red local. Otras apps y Safari no se ven afectadas, por eso parece un problema de conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ei tavoita verkkosi palvelimia, koska tämä laite estää paikallisverkon käytön. Muut apit ja Safari toimivat normaalisti, minkä vuoksi tämä näyttää katkenneelta yhteydeltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ne peut pas joindre les serveurs de votre réseau, car cet appareil bloque l'accès au réseau local. Les autres apps et Safari ne sont pas concernés, ce qui donne l'impression d'une connexion défaillante."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ne može doći do poslužitelja na vašoj mreži jer ovaj uređaj blokira pristup lokalnoj mreži. Ostale aplikacije i Safari rade normalno, zbog čega ovo izgleda kao prekinuta veza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sodalite nem éri el a hálózatán lévő kiszolgálókat, mert ez az eszköz blokkolja a helyi hálózat elérését. A többi appot és a Safarit ez nem érinti, ezért tűnik megszakadt kapcsolatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite non riesce a raggiungere i server della tua rete perché questo dispositivo blocca l'accesso alla rete locale. Le altre app e Safari non sono interessate, per questo sembra un problema di connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスがローカルネットワークへのアクセスをブロックしているため、Sodaliteはネットワーク上のサーバーに接続できません。他のAppやSafariは影響を受けないので、接続の問題のように見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 로컬 네트워크 접근을 차단하고 있어 Sodalite가 네트워크의 서버에 연결할 수 없습니다. 다른 앱과 Safari는 영향을 받지 않기 때문에 연결 문제처럼 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite når ikke tjenerne på nettverket ditt fordi denne enheten blokkerer tilgang til det lokale nettverket. Andre apper og Safari er upåvirket, og derfor ser dette ut som en brutt forbindelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite kan de servers op je netwerk niet bereiken omdat dit apparaat toegang tot het lokale netwerk blokkeert. Andere apps en Safari werken gewoon, waardoor dit op een verbroken verbinding lijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nie może połączyć się z serwerami w Twojej sieci, ponieważ to urządzenie blokuje dostęp do sieci lokalnej. Inne aplikacje i Safari działają normalnie, dlatego wygląda to na przerwane połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sodalite não consegue alcançar os servidores da sua rede porque este dispositivo bloqueia o acesso à rede local. Outros apps e o Safari não são afetados, por isso parece um problema de conexão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sodalite não consegue alcançar os servidores da sua rede porque este dispositivo bloqueia o acesso à rede local. As outras aplicações e o Safari não são afetados, por isso parece um problema de ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nu poate contacta serverele din rețeaua dvs. deoarece acest dispozitiv blochează accesul la rețeaua locală. Celelalte aplicații și Safari nu sunt afectate, de aceea pare o conexiune întreruptă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite не может связаться с серверами в вашей сети, потому что это устройство блокирует доступ к локальной сети. Другие приложения и Safari работают как обычно, поэтому это выглядит как обрыв связи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite sa nedokáže spojiť so servermi vo vašej sieti, pretože toto zariadenie blokuje prístup k lokálnej sieti. Ostatné aplikácie ani Safari to neovplyvňuje, preto to vyzerá ako prerušené pripojenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite når inte servrarna på ditt nätverk eftersom den här enheten blockerar åtkomst till det lokala nätverket. Andra appar och Safari påverkas inte, vilket gör att det ser ut som ett anslutningsfel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıt yerel ağ erişimini engellediği için Sodalite ağınızdaki sunuculara ulaşamıyor. Diğer uygulamalar ve Safari etkilenmez, bu yüzden bağlantı sorunu gibi görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite не може зв'язатися із серверами у вашій мережі, бо цей пристрій блокує доступ до локальної мережі. Інші програми та Safari працюють як завжди, тому це має вигляд обриву зв'язку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备阻止了本地网络访问，因此 Sodalite 无法连接到您网络中的服务器。其他 App 和 Safari 浏览器不受影响，所以这看起来像是网络故障。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置封鎖了區域網路取用權限，因此 Sodalite 無法連接你網路上的伺服器。其他 App 和 Safari 不受影響，所以這看起來像是連線問題。"
          }
        }
      }
    },
