    "server.offNetwork.body" : {
      "comment" : "Subtitle under server.offNetwork.title, shown only where the button below it exists. Says what to do, not what went wrong.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej pro tento server externí adresu, aby byl dostupný odkudkoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en ekstern adresse til denne server, så du kan nå den overalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge diesem Server eine externe Adresse hinzu, damit er von überall erreichbar ist."
