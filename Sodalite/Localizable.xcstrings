    "settings.playback.touchpadScrubbing.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím po dotykové ploše ovladače posunete přehrávání. Vypnuto posouvají jen tlačítka vlevo a vpravo, takže položený palec časovou osou nepohne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk hen over fjernbetjeningens berøringsflade for at flytte afspilningen. Slået fra spoler kun venstre og højre, så en hvilende tommelfinger ikke kan flytte tidslinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über die Touchfläche der Fernbedienung wischen, um die Wiedergabeposition zu verschieben. Aus springen nur Links und Rechts, ein aufliegender Daumen verschiebt die Zeitleiste also nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε πάνω στην επιφάνεια αφής του τηλεχειριστηρίου για να μετακινήσετε την αναπαραγωγή. Απενεργοποιημένο, μεταπηδούν μόνο το αριστερά και το δεξιά, οπότε ένας ακίνητος αντίχειρας δεν μετακινεί τη γραμμή χρόνου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across the remote's touch surface to move the playhead. Off, only left and right seek, so a resting thumb cannot shift the timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza por la superficie táctil del mando para mover la reproducción. Desactivado, solo avanzan izquierda y derecha, así que un pulgar apoyado no mueve la línea de tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä kaukosäätimen kosketuspinnalla siirtääksesi toistokohtaa. Pois päältä vain vasen ja oikea kelaavat, joten paikallaan lepäävä peukalo ei siirrä aikajanaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le doigt sur la surface tactile de la télécommande pour déplacer la lecture. Désactivé, seuls gauche et droite se déplacent, un pouce posé ne bouge donc pas la timeline."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite prstom po dodirnoj površini daljinskog za pomicanje reprodukcije. Isključeno, premotavaju samo lijevo i desno, pa naslonjeni palac ne pomiče vremensku traku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza az ujját a távirányító érintőfelületén a lejátszási pozíció mozgatásához. Kikapcsolva csak a balra és a jobbra tekert, így a rajta pihenő hüvelykujj nem mozdítja el az idővonalat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri sulla superficie touch del telecomando per spostare la riproduzione. Disattivato, si spostano solo sinistra e destra, così un pollice appoggiato non muove la timeline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコンのタッチ面をなぞると再生位置が動きます。オフのときは左右のみが移動し、指を置いたままでもタイムラインは動きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨 터치 면을 문질러 재생 위치를 옮깁니다. 끄면 좌우 버튼만 탐색하므로 손가락을 올려 두어도 타임라인이 움직이지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra over fjernkontrollens berøringsflate for å flytte avspillingen. Av spoler bare venstre og høyre, så en hvilende tommel ikke flytter tidslinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg over het aanraakvlak van de afstandsbediening om de afspeelpositie te verplaatsen. Uit verspringen alleen links en rechts, zodat een rustende duim de tijdlijn niet verschuift."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem po polu dotykowym pilota, aby przesunąć odtwarzanie. Wyłączone, przewijają tylko lewo i prawo, więc spoczywający kciuk nie przesunie osi czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize pela superfície sensível ao toque do controle para mover a reprodução. Desativado, apenas esquerda e direita avançam, então um dedo apoiado não move a linha do tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize pela superfície tátil do comando para mover a reprodução. Desativado, apenas esquerda e direita avançam, pelo que um dedo pousado não move a linha temporal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați pe suprafața tactilă a telecomenzii pentru a muta redarea. Dezactivat, derulează doar stânga și dreapta, așa că un deget sprijinit nu mișcă cronologia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите по сенсорной панели пульта, чтобы переместить позицию воспроизведения. Когда выключено, перематывают только «влево» и «вправо», поэтому лежащий палец не сдвинет шкалу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím po dotykovej ploche diaľkového ovládača posuniete prehrávanie. Vypnuté, posúvajú len tlačidlá vľavo a vpravo, takže položený palec časovou osou nepohne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra över fjärrkontrollens pekyta för att flytta uppspelningen. Av spolar bara vänster och höger, så en vilande tumme inte flyttar tidslinjen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma konumunu taşımak için kumandanın dokunmatik yüzeyinde parmağınızı kaydırın. Kapalıyken yalnızca sol ve sağ atlar, böylece duran bir parmak zaman çizelgesini oynatmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть по сенсорній панелі пульта, щоб перемістити позицію відтворення. Коли вимкнено, перемотують лише «вліво» і «вправо», тож палець, що лежить, не зсуне шкалу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在遥控器触控面上滑动即可移动播放位置。关闭后只有左右键跳转，手指搁在触控面上也不会移动时间轴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在遙控器觸控面上滑動即可移動播放位置。關閉後只有左右鍵跳轉，手指擱在觸控面上也不會移動時間軸。"
          }
        }
      }
    },
