          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szüneteltetve: másik iCloud-fiók jelentkezett be. Kapcsold be újra a szinkronizálást, hogy ezzel a fiókkal használd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
