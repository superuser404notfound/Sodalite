    "home.customize.collectionGrouping.subtitle" : {
      "comment" : "Subtitle for the group movies into collections picker",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při procházení knihovny zobrazí sbírku jako jedinou dlaždici. Výchozí nastavení serveru se řídí Jellyfinem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en samling som ét felt, når du gennemser et bibliotek. Serverstandard følger Jellyfin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt eine Sammlung beim Durchsuchen einer Bibliothek als eine einzige Kachel. Serverstandard richtet sich nach Jellyfin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει μια συλλογή ως ένα πλακίδιο κατά την περιήγηση σε βιβλιοθήκη. Η προεπιλογή διακομιστή ακολουθεί το Jellyfin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a collection as a single tile when browsing a library. Server default follows the Jellyfin server setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una colección como una sola tarjeta al explorar una biblioteca. «Según el servidor» sigue el ajuste de Jellyfin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää kokoelman yhtenä ruutuna kirjastoa selatessa. Palvelimen oletus noudattaa Jellyfinin asetusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une collection sous forme d’une seule vignette lors de la navigation dans une médiathèque. Le réglage du serveur suit Jellyfin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje zbirku kao jednu pločicu pri pregledu knjižnice. „Prema poslužitelju“ slijedi postavku Jellyfina."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy gyűjteményt egyetlen csempeként jelenít meg a könyvtár böngészésekor. A „Kiszolgáló szerint“ a Jellyfin beállítását követi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una raccolta come un unico riquadro sfogliando una libreria. «Predefinito del server» segue l’impostazione di Jellyfin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリを見るとき、コレクションを 1 つのタイルとして表示します。「サーバー既定」は Jellyfin の設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리를 탐색할 때 컬렉션을 하나의 타일로 표시합니다. ‘서버 기본값’은 Jellyfin 설정을 따릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en samling som én rute når du blar i et bibliotek. Serverstandard følger Jellyfin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een collectie als één tegel bij het bladeren door een bibliotheek. Serverstandaard volgt Jellyfin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przeglądania biblioteki pokazuje kolekcję jako jeden kafelek. „Ustawienie serwera“ podąża za ustawieniem Jellyfina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma coleção como um único bloco ao navegar por uma biblioteca. «Padrão do servidor» segue a configuração do Jellyfin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma coleção como um único mosaico ao navegar numa biblioteca. «Predefinição do servidor» segue a definição do Jellyfin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează o colecție ca o singură plăcuță la parcurgerea unei biblioteci. „Implicit server“ urmează setarea Jellyfin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает коллекцию одной плиткой при просмотре медиатеки. «Как на сервере» следует настройке Jellyfin."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri prehliadaní knižnice zobrazí zbierku ako jednu dlaždicu. „Podľa servera“ sa riadi nastavením Jellyfinu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en samling som en enda ruta när du bläddrar i ett bibliotek. Serverstandard följer Jellyfin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kitaplığa göz atarken koleksiyonu tek bir kutucuk olarak gösterir. «Sunucu varsayılanı» Jellyfin ayarını izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує колекцію однією плиткою під час перегляду медіатеки. «Як на сервері» дотримується налаштування Jellyfin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览媒体库时将合集显示为单个磁贴。“服务器默认”遵循 Jellyfin 的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽媒體庫時將合輯顯示為單一圖磚。「伺服器預設」依循 Jellyfin 的設定。"
          }
        }
      }
    },
