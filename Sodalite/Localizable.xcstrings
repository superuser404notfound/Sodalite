    "player.error.audioTrack.body" : {
      "comment" : "Advice for a track the engine cannot carry: pick another one, since the session is gone either way",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto zvukovou stopu se nepodařilo přehrát. Spusťte titul znovu a zvolte jinou zvukovou stopu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette lydspor kunne ikke afspilles. Start titlen igen, og vælg et andet lydspor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Tonspur konnte nicht wiedergegeben werden. Titel erneut starten und eine andere Tonspur wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αναπαραγωγή αυτού του κομματιού ήχου. Ξεκινήστε ξανά τον τίτλο και επιλέξτε άλλο κομμάτι ήχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This audio track could not be played. Start the title again and choose a different audio track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo reproducir esta pista de audio. Vuelve a iniciar el título y elige otra pista de audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä ääniraitaa ei voitu toistaa. Käynnistä nimike uudelleen ja valitse toinen ääniraita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette piste audio n'a pas pu être lue. Relancez le titre et choisissez une autre piste audio."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj zvučni zapis nije bilo moguće reproducirati. Ponovno pokrenite naslov i odaberite drugi zvučni zapis."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a hangsávot nem sikerült lejátszani. Indítsd újra a címet, és válassz másik hangsávot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile riprodurre questa traccia audio. Riavvia il titolo e scegli un'altra traccia audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このオーディオトラックは再生できませんでした。タイトルを再生し直して、別のオーディオトラックを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 오디오 트랙을 재생할 수 없습니다. 타이틀을 다시 시작한 후 다른 오디오 트랙을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette lydsporet kunne ikke spilles av. Start tittelen på nytt og velg et annet lydspor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit audiospoor kon niet worden afgespeeld. Start de titel opnieuw en kies een ander audiospoor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odtworzyć tej ścieżki dźwiękowej. Uruchom tytuł ponownie i wybierz inną ścieżkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reproduzir esta faixa de áudio. Inicie o título novamente e escolha outra faixa de áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reproduzir esta faixa de áudio. Inicie o título novamente e escolha outra faixa de áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această pistă audio nu a putut fi redată. Porniți titlul din nou și alegeți altă pistă audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось воспроизвести эту аудиодорожку. Запустите фильм заново и выберите другую дорожку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túto zvukovú stopu sa nepodarilo prehrať. Spustite titul znova a vyberte inú zvukovú stopu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här ljudspåret kunde inte spelas upp. Starta titeln igen och välj ett annat ljudspår."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ses parçası oynatılamadı. Başlığı yeniden başlatın ve farklı bir ses parçası seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відтворити цю аудіодоріжку. Запустіть запис знову та виберіть іншу доріжку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法播放此音轨。请重新开始播放并选择其他音轨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法播放此音軌。請重新開始播放並選擇其他音軌。"
          }
        }
      }
    },
