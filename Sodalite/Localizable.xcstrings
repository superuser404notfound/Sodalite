    "settings.playback.picture.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak video vyplňuje obrazovku — zachovat poměr stran nebo přiblížit a oříznout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan videoen udfylder skærmen — bevar forholdet eller zoom og beskær."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie das Video den Bildschirm füllt — Seitenverhältnis beibehalten oder hineinzoomen und beschneiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς γεμίζει η εικόνα την οθόνη — διατήρηση αναλογίας ή ζουμ και περικοπή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the video fills the screen: preserve aspect or zoom and crop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo llena la pantalla el vídeo: mantener proporción o ampliar y recortar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten kuva täyttää näytön — säilytä mittasuhteet tai zoomaa ja rajaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment la vidéo remplit l'écran : conserver le ratio ou zoomer et rogner."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako video ispunjava zaslon — sačuvaj omjer ili zumiraj i izreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogyan tölti ki a kép a képernyőt — arány megtartva, vagy ráközelítve és vágva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come il video riempie lo schermo: mantieni proporzioni o zoom e ritaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像が画面をどう埋めるか — アスペクト比保持か、ズームして切り抜くか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상이 화면을 채우는 방식 — 비율 유지 또는 확대 후 자르기."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan videoen fyller skjermen — behold forhold eller zoom og beskjær."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe de video het scherm vult — verhouding behouden of zoomen en bijsnijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak wideo wypełnia ekran — zachowaj proporcje lub przybliż i przytnij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o vídeo preenche a tela — preservar proporção ou aproximar e cortar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o vídeo preenche o ecrã — preservar proporção ou ampliar e cortar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum umple imaginea ecranul — păstrează raportul sau apropie și decupează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как видео заполняет экран — сохранить пропорции или увеличить и обрезать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako video vypĺňa obrazovku — zachovať pomer alebo priblížiť a orezať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur videon fyller skärmen — behåll förhållande eller zooma och beskär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntünün ekranı nasıl doldurduğu — oranı koru veya yakınlaştır ve kırp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як відео заповнює екран — зберегти співвідношення чи наблизити та обрізати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频如何填充屏幕 — 保持比例或放大裁剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片如何填滿螢幕 — 保持比例或放大裁切。"
          }
        }
      }
    },
