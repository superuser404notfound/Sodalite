    "support.pack.subtitle" : {
      "comment" : "Subtitle explaining what the Supporter Pack unlocks",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorázové odemčení. Pečlivě vybrané palety barev zvýraznění, prémiová animovaná pozadí a speciální úvodní ikona."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engangsoplåsning. Kuraterede paletter med fremhævningsfarver, animerede premiumbaggrunde og et særligt splash-ikon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmalig freischalten. Kuratierte Akzentpaletten, animierte Premium-Hintergründe und ein spezielles Splash-Icon."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφάπαξ ξεκλείδωμα. Επιλεγμένες παλέτες χρωμάτων έμφασης, premium κινούμενα φόντα και ένα ειδικό εικονίδιο έναρξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time unlock. Curated accent palettes, premium animated backgrounds, and a special splash icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueo único. Paletas de colores de acento seleccionadas, fondos animados prémium y un icono de inicio especial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertaluonteinen avaus. Huolella valitut korostusväripaletit, animoidut premium-taustat ja erityinen käynnistyskuvake."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déblocage unique. Palettes d’accentuation soigneusement composées, arrière-plans animés premium et icône de lancement spéciale."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednokratno otključavanje. Pomno odabrane palete naglasnih boja, premium animirane pozadine i posebna uvodna ikona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszeri feloldás. Gondosan összeállított kiemelőszín-paletták, prémium animált hátterek és egy különleges nyitóikon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocco una tantum. Palette di colori d’accento curate, sfondi animati premium e un’icona iniziale speciale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一回限りのアンロック。厳選されたアクセントパレット、プレミアムアニメーション背景、特別なスプラッシュアイコンが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일회성 잠금 해제. 엄선된 강조 색상 팔레트, 프리미엄 애니메이션 배경, 특별한 스플래시 아이콘이 포함됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engangsopplåsing. Håndplukkede aksentpaletter, animerte premiumbakgrunner og et spesielt splash-ikon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenmalige ontgrendeling. Zorgvuldig samengestelde accentpaletten, premium geanimeerde achtergronden en een speciaal splash-icoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazowe odblokowanie. Starannie dobrane palety kolorów akcentu, animowane tła premium i specjalna ikona powitalna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueio único. Paletas de cores de destaque selecionadas, fundos animados premium e um ícone de abertura especial."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueio único. Paletas de cores de realce selecionadas, fundos animados premium e um ícone de abertura especial."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deblocare unică. Palete atent selecționate de culori de accent, fundaluri animate premium și o pictogramă de pornire specială."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разовая разблокировка. Тщательно подобранные палитры акцентных цветов, премиальные анимированные фоны и специальная заставка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazové odomknutie. Starostlivo vybrané palety farieb zvýraznenia, prémiové animované pozadia a špeciálna úvodná ikona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engångsupplåsning. Handplockade accentpaletter, animerade premiumbakgrunder och en särskild startikon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek seferlik kilit açma. Özenle seçilmiş vurgu rengi paletleri, premium animasyonlu arka planlar ve özel bir açılış simgesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разове розблокування. Ретельно підібрані палітри акцентних кольорів, преміальні анімовані фони та спеціальна заставка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性解锁。包含精心挑选的强调色调色板、高级动态背景和特殊启动图标。"
          }
        },
        "zh-Hant" : {
