    "changelog.0_4_1.episodePicker.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepněte na libovolnou epizodu aktuální sezóny bez opouštění přehrávače — s náhledy pro každý řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hop til ethvert afsnit af den aktuelle sæson uden at forlade afspilleren — med miniaturer for hver række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle ohne den Player zu verlassen direkt zu jeder Folge der Staffel — mit Vorschau-Bild pro Zeile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβείτε σε οποιοδήποτε επεισόδιο της τρέχουσας σεζόν χωρίς να βγείτε από το πρόγραμμα — με προεπισκόπηση ανά γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump to any episode of the current season without leaving the player, thumbnail preview per row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta a cualquier episodio de la temporada actual sin salir del reproductor — miniatura por fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyppää nykyisen kauden mille tahansa jaksolle poistumatta soittimesta — esikatselukuva riviä kohden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sautez à n'importe quel épisode de la saison en cours sans quitter le lecteur — miniature par ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skočite na bilo koju epizodu trenutne sezone bez napuštanja reproduktora — sličica u svakom redu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugrás az aktuális évad bármelyik epizódjára anélkül, hogy elhagynád a lejátszót — előnézeti kép soronként."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a qualsiasi episodio della stagione attuale senza uscire dal player — miniatura per riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーを離れずに現在のシーズンの任意のエピソードに移動できます — 各行にサムネイル付き。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어를 떠나지 않고 현재 시즌의 어떤 에피소드로든 이동할 수 있습니다 — 각 행에 썸네일 표시."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp til hvilken som helst episode i den aktuelle sesongen uten å forlate spilleren — miniatyr per rad."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring naar elke aflevering van het huidige seizoen zonder de speler te verlaten — miniatuur per rij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeskocz do dowolnego odcinka aktualnego sezonu bez opuszczania odtwarzacza — miniatura w każdym wierszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pule para qualquer episódio da temporada atual sem sair do player — miniatura por linha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta para qualquer episódio da temporada atual sem sair do reprodutor — miniatura por linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sari la orice episod al sezonului curent fără a părăsi playerul — miniatură pe rând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайтесь на любую серию текущего сезона, не выходя из плеера — превью в каждой строке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skočte na ktorúkoľvek epizódu aktuálnej sezóny bez opustenia prehrávača — miniatúra v každom riadku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa till vilket avsnitt som helst i nuvarande säsong utan att lämna spelaren — miniatyr per rad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcıdan çıkmadan mevcut sezonun herhangi bir bölümüne atlayın — her satırda küçük resim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдіть до будь-якого епізоду поточного сезону, не залишаючи програвач — мініатюра в кожному рядку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需离开播放器即可跳转到当前季的任何一集 — 每行都有缩略图预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需離開播放器即可跳轉到當前季的任何一集 — 每行都有縮圖預覽。"
          }
        }
      }
    },
