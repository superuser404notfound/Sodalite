    "changelog.0_5_0.foregroundReload.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návrat z pozadí přistává přímo na obnoveném snímku místo černého záblesku — engine teď před pozastavením čeká na první dekódovaný snímek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At vende tilbage fra baggrunden lander på det faktiske genoptagne billede i stedet for et sort blink — motoren venter nu på det første afkodede billede, før den pausér."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rückkehr aus dem Hintergrund landet jetzt direkt am Resume-Frame statt auf Schwarz — die Engine wartet auf das erste dekodierte Bild, bevor sie pausiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιστροφή από το παρασκήνιο φτάνει στο πραγματικό καρέ συνέχισης αντί για μια μαύρη αναλαμπή — η μηχανή περιμένει τώρα το πρώτο αποκωδικοποιημένο καρέ πριν παύσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coming back from background lands on the actual resumed frame instead of a black flash. The engine now waits for the first decoded frame before pausing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al volver desde segundo plano la app aterriza en el fotograma reanudado real en lugar de un parpadeo negro — el motor ahora espera al primer fotograma decodificado antes de pausar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustalta palaaminen päätyy oikeaan jatkokuvaan mustan välähdyksen sijaan — moottori odottaa nyt ensimmäisen puretun kuvan ennen taukoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retour depuis l'arrière-plan affiche directement l'image reprise au lieu d'un flash noir — le moteur attend désormais la première image décodée avant de mettre en pause."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povratak iz pozadine sada slijeće na stvarni kadar nastavka umjesto crnog bljeska — engine sada čeka prvi dekodirani kadar prije pauziranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérből való visszatérés a tényleges folytatási képkockán landol egy fekete villanás helyett — a motor mostantól megvárja az első dekódolt képkockát, mielőtt szüneteltetne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornando dal background si arriva direttamente al fotogramma di ripresa invece che a un flash nero — il motore ora attende il primo fotogramma decodificato prima di mettere in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドから戻ったとき、黒い一瞬の表示ではなく実際のレジューム・フレームから始まります。エンジンが一時停止する前に最初のデコード済みフレームを待つようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 돌아올 때 검은 화면 대신 실제 재개 프레임에서 시작합니다 — 엔진이 일시 정지하기 전에 첫 디코딩된 프레임을 기다립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å komme tilbake fra bakgrunnen lander på den faktiske gjenopptatte rammen i stedet for et svart blink — motoren venter nå på den første dekodede rammen før den pauser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugkeren uit de achtergrond komt direct uit op het hervatte frame in plaats van op een zwarte flits — de engine wacht nu op het eerste gedecodeerde frame voordat hij pauzeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót z tła kończy się na faktycznym wznowionym kadrze zamiast na czarnym błysku — silnik czeka teraz na pierwszą zdekodowaną klatkę przed wstrzymaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar do segundo plano leva direto ao quadro retomado em vez de um flash preto — o motor agora espera o primeiro quadro decodificado antes de pausar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regressar do segundo plano leva directamente ao fotograma retomado em vez de um flash preto — o motor agora espera o primeiro fotograma descodificado antes de fazer pausa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenirea din fundal aterizează pe cadrul real de reluare în loc de un fulger negru — motorul așteaptă acum primul cadru decodat înainte de a face pauză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возврат из фона теперь приходит на реальный кадр возобновления вместо чёрного мигания — движок дожидается первого декодированного кадра перед паузой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návrat z pozadia teraz pristane priamo na obnovenom snímku namiesto čierneho záblesku — engine pred pozastavením čaká na prvý dekódovaný snímok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att komma tillbaka från bakgrunden landar på den faktiska återupptagna bildrutan istället för en svart blinkning — motorn väntar nu på den första avkodade bildrutan innan den pausar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plandan dönüş artık siyah bir parıltı yerine doğrudan devam eden kareye düşüyor — motor duraklatmadan önce ilk çözülmüş kareyi bekliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернення з фону потрапляє на справжній кадр відновлення замість чорного спалаху — рушій тепер чекає на перший декодований кадр перед паузою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从后台返回时直接定位到真正的恢复帧,不再出现黑色闪烁——引擎现在会等到第一帧解码完成后再暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從背景返回時直接定位到實際的恢復幀,不再出現黑色閃爍——引擎現在會等到第一幀解碼完成後再暫停。"
          }
        }
      }
    },
