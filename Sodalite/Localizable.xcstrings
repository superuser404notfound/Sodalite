    "player.error.serverLost.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite se už nemůže spojit s %@. Přehrávání bylo pozastaveno, tvoje pozice zůstává uložena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite kan ikke længere nå %@. Afspilningen er sat på pause, og din position er gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite erreicht %@ nicht mehr. Die Wiedergabe wurde angehalten, deine Position bleibt gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sodalite δεν μπορεί πλέον να συνδεθεί με %@. Η αναπαραγωγή διακόπηκε, η θέση σου διατηρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite can no longer reach %@. Playback was paused, your position is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ya no puede conectar con %@. La reproducción se ha pausado y se conserva tu posición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ei enää tavoita palvelinta %@. Toisto keskeytettiin, kohtasi säilyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite n'atteint plus %@. La lecture a été mise en pause, ta position est conservée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite više ne može doći do %@. Reprodukcija je pauzirana, tvoja pozicija je sačuvana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sodalite már nem éri el a következőt: %@. A lejátszás szünetel, a pozíciód megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite non riesce più a raggiungere %@. La riproduzione è in pausa, la tua posizione è stata salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite は %@ に接続できなくなりました。再生を一時停止しました。再生位置は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite가 %@에 더 이상 연결할 수 없습니다. 재생을 일시정지했으며 위치는 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite når ikke lenger %@. Avspillingen ble satt på pause, og posisjonen din er lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite kan %@ niet meer bereiken. Het afspelen is gepauzeerd, je positie blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nie może już połączyć się z %@. Odtwarzanie wstrzymano, twoja pozycja została zachowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sodalite não consegue mais alcançar %@. A reprodução foi pausada e sua posição foi mantida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sodalite já não consegue alcançar %@. A reprodução foi pausada e a tua posição foi guardada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nu mai poate contacta %@. Redarea a fost întreruptă, poziția ta este păstrată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite больше не может связаться с %@. Воспроизведение приостановлено, позиция сохранена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite sa už nedokáže spojiť s %@. Prehrávanie bolo pozastavené, tvoja pozícia zostáva uložená."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite når inte längre %@. Uppspelningen pausades och din position sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite artık %@ sunucusuna ulaşamıyor. Oynatma duraklatıldı, konumun korunuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite більше не може зв'язатися з %@. Відтворення призупинено, твоя позиція збережена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite 无法再连接到 %@。播放已暂停，进度已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite 無法再連線到 %@。播放已暫停，進度已保留。"
          }
        }
      }
    },
