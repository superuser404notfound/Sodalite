    "settings.reset.confirm.message" : {
      "comment" : "Body of the reset confirmation alert",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny servery, profily a nastavení v tomto zařízení budou odstraněny a Sodalite začne od začátku. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servere, profiler og indstillinger på denne enhed fjernes, og Sodalite starter forfra. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Server, Profile und Einstellungen auf diesem Gerät werden entfernt und Sodalite beginnt von vorn. Das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι οι διακομιστές, τα προφίλ και οι ρυθμίσεις σε αυτήν τη συσκευή θα αφαιρεθούν και το Sodalite θα ξεκινήσει από την αρχή. Η ενέργεια δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every server, profile and setting on this device is removed and Sodalite starts over. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los servidores, perfiles y ajustes de este dispositivo y Sodalite empezará de cero. Esta acción no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tämän laitteen palvelimet, profiilit ja asetukset poistetaan ja Sodalite aloittaa alusta. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les serveurs, profils et réglages de cet appareil sont supprimés et Sodalite repart de zéro. Cette action est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi poslužitelji, profili i postavke na ovom uređaju bit će uklonjeni i Sodalite kreće ispočetka. Radnju nije moguće poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközön lévő összes kiszolgáló, profil és beállítás törlődik, és a Sodalite elölről kezdi. A művelet nem vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i server, i profili e le impostazioni su questo dispositivo vengono rimossi e Sodalite riparte da zero. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上のすべてのサーバ、プロファイル、設定が削除され、Sodaliteは最初からやり直します。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 모든 서버, 프로필, 설정이 삭제되고 Sodalite가 처음부터 다시 시작됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servere, profiler og innstillinger på denne enheten fjernes, og Sodalite starter på nytt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servers, profielen en instellingen op dit apparaat worden verwijderd en Sodalite begint opnieuw. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie serwery, profile i ustawienia na tym urządzeniu zostaną usunięte, a Sodalite zacznie od nowa. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os servidores, perfis e ajustes deste dispositivo são removidos e o Sodalite recomeça do zero. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os servidores, perfis e definições neste dispositivo são removidos e o Sodalite recomeça do zero. Não é possível anular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate serverele, profilurile și setările de pe acest dispozitiv sunt eliminate, iar Sodalite o ia de la capăt. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все серверы, профили и настройки на этом устройстве будут удалены, и Sodalite начнёт с чистого листа. Отменить это действие нельзя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky servery, profily a nastavenia v tomto zariadení sa odstránia a Sodalite začne odznova. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla servrar, profiler och inställningar på den här enheten tas bort och Sodalite börjar om. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdaki tüm sunucular, profiller ve ayarlar kaldırılır ve Sodalite sıfırdan başlar. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі сервери, профілі та налаштування на цьому пристрої буде вилучено, і Sodalite почне з чистого аркуша. Скасувати цю дію неможливо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本设备上的所有服务器、配置文件和设置都会被移除，Sodalite 将重新开始。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本裝置上的所有伺服器、設定檔和設定都會被移除，Sodalite 將重新開始。此操作無法復原。"
          }
        }
      }
    },
