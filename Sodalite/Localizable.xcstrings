    "changelog.1_0_0.trackMemory.body" : {
      "comment" : "Changelog highlight for the 1.0.0 release",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuková stopa a titulky, které si vybereš, se vrátí i příště. Filmy si pamatují svoje, epizody sdílí jednu volbu na seriál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lyd- og undertekstspor, du vælger, kommer igen næste gang. Film husker deres eget, afsnit deler ét valg pr. serie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählte Ton- und Untertitelspur ist beim nächsten Mal wieder da. Filme merken sich ihre eigene, Episoden teilen sich eine pro Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κομμάτι ήχου και υποτίτλων που διαλέγεις επιστρέφει την επόμενη φορά. Οι ταινίες θυμούνται το δικό τους, τα επεισόδια μοιράζονται ένα ανά σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio and subtitle track you pick comes back next time. Movies remember their own, episodes share one per series."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pista de audio y de subtítulos que elijas vuelve la próxima vez. Las películas recuerdan la suya, los episodios comparten una por serie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemasi ääni- ja tekstitysraita palaa ensi kerralla. Elokuvat muistavat omansa, jaksot jakavat yhden sarjaa kohden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La piste audio et de sous-titres choisie revient la fois suivante. Les films retiennent la leur, les épisodes en partagent une par série."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabrani zvučni zapis i titlovi vraćaju se sljedeći put. Filmovi pamte svoje, epizode dijele jedan po seriji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott hang- és feliratsáv legközelebb visszatér. A filmek a sajátjukat jegyzik meg, az epizódok sorozatonként osztoznak egyen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traccia audio e dei sottotitoli che scegli torna la volta dopo. I film ricordano la propria, gli episodi ne condividono una per serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ音声トラックと字幕トラックが次回もそのまま戻ります。映画はそれぞれ個別に、エピソードはシリーズごとに共有します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 오디오와 자막 트랙이 다음에도 그대로 돌아옵니다. 영화는 각자, 에피소드는 시리즈별로 하나를 공유합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd- og undertekstsporet du velger, kommer tilbake neste gang. Filmer husker sitt eget, episoder deler ett per serie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het audio- en ondertitelspoor dat je kiest, komt de volgende keer terug. Films onthouden hun eigen keuze, afleveringen delen er een per serie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrana ścieżka dźwiękowa i napisy wracają następnym razem. Filmy pamiętają swoje, odcinki dzielą jedną na serial."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faixa de áudio e de legenda que você escolhe volta na próxima vez. Filmes lembram a sua, episódios compartilham uma por série."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faixa de áudio e de legendas que escolhes volta da próxima vez. Os filmes lembram a sua, os episódios partilham uma por série."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pista audio și de subtitrare pe care o alegi revine data viitoare. Filmele o rețin pe a lor, episoadele împart una per serial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранная звуковая дорожка и субтитры вернутся в следующий раз. Фильмы помнят свою, серии делят одну на сериал."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolená zvuková stopa a titulky sa nabudúce vrátia. Filmy si pamätajú svoje, epizódy zdieľajú jednu na seriál."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljud- och undertextspåret du väljer kommer tillbaka nästa gång. Filmer minns sitt eget, avsnitt delar ett per serie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz ses ve altyazı parçası bir dahaki sefere geri gelir. Filmler kendininkini hatırlar, bölümler dizi başına birini paylaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрана звукова доріжка та субтитри повернуться наступного разу. Фільми пам'ятають свою, серії ділять одну на серіал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选的音轨和字幕轨下次还在。影片各记各的，剧集按整部共用一份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你選的音軌和字幕軌下次還在。影片各記各的，影集按整部共用一份。"
          }
        }
      }
    },
