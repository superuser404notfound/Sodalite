    "changelog.0_4_1.backgroundPause.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesun aplikace na pozadí pozastaví přehrávání. Přepínač aplikací (dvojitý Home) přehrávání nepřeruší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når appen sendes i baggrunden pauses afspilningen. App-skifteren (dobbelt Home) lader den fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App in den Hintergrund geht, pausiert die Wiedergabe. Der App-Umschalter (Home-Doppelklick) lässt sie weiterlaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η εφαρμογή πάει στο παρασκήνιο, η αναπαραγωγή κάνει παύση. Ο εναλλάκτης εφαρμογών (διπλό Home) την αφήνει να συνεχίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backgrounding the app pauses playback. The app switcher (double-Home) leaves it playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al enviar la app al fondo, la reproducción se pausa. El selector de apps (doble Home) la deja seguir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen siirtäminen taustalle keskeyttää toiston. Sovellusvalitsin (kaksoisnapautus Home) ei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre l'app en arrière-plan met la lecture en pause. Le sélecteur d'apps (double Home) la laisse continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slanje aplikacije u pozadinu pauzira reprodukciju. Preklopnik aplikacija (dvostruki Home) je ne prekida."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás háttérbe küldése szünetelteti a lejátszást. Az alkalmazásváltó (dupla Home) tovább engedi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettere l'app in background mette in pausa. Lo switcher app (doppio Home) la lascia in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリをバックグラウンドにすると再生が一時停止します。アプリスイッチャー(Homeボタンのダブルクリック)では再生は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 백그라운드로 보내면 재생이 일시 정지됩니다. 앱 전환기(Home 더블 클릭)에서는 재생이 계속됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å sende appen i bakgrunnen pauser avspillingen. App-velgeren (dobbelt Home) lar den spille videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app naar de achtergrond sturen pauzeert het afspelen. De app-wisselaar (dubbele Home) niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłanie aplikacji w tło wstrzymuje odtwarzanie. Przełącznik aplikacji (podwójny Home) nie przerywa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar o app para segundo plano pausa a reprodução. O alternador de apps (Home duplo) não."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar a app para segundo plano pausa a reprodução. O alternador de apps (Home duplo) não."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimiterea aplicației în fundal pune redarea în pauză. Comutatorul de aplicații (Home dublu) o lasă să meargă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сворачивание приложения в фон ставит воспроизведение на паузу. Переключатель приложений (двойной Home) — нет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presunutie aplikácie na pozadie pozastaví prehrávanie. Prepínač aplikácií (dvojitý Home) ho ponechá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att lägga appen i bakgrunden pausar uppspelningen. App-växlaren (dubbel Home) lämnar den igång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı arka plana almak oynatmayı duraklatır. Uygulama değiştirici (çift Home) duraklatmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Згортання застосунку у фон ставить відтворення на паузу. Перемикач застосунків (подвійний Home) — ні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将应用切到后台会暂停播放。应用切换器(双击 Home)则继续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將應用切到背景會暫停播放。應用切換器(雙擊 Home)則繼續播放。"
          }
        }
      }
    },
