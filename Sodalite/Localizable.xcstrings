    "changelog.0_4_0.cardHeights.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblíbené sbírky se nyní zobrazují ve stejné výšce jako filmy a seriály."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritsamlinger vises nu i samme højde som film og serier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorisierte Sammlungen sind jetzt gleich hoch wie Filme und Serien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αγαπημένες συλλογές εμφανίζονται τώρα στο ίδιο ύψος με τις ταινίες και τις σειρές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favourited collections now sit at the same height as movies and series."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones favoritas ahora tienen la misma altura que películas y series."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suosikkikokoelmat näkyvät nyt samalla korkeudella kuin elokuvat ja sarjat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections favorites s'affichent maintenant à la même hauteur que les films et les séries."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omiljene zbirke sada su iste visine kao filmovi i serije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kedvenc gyűjtemények most ugyanolyan magasak, mint a filmek és sorozatok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collezioni preferite ora hanno la stessa altezza di film e serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りのコレクションが映画やシリーズと同じ高さで表示されるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기한 컬렉션이 이제 영화 및 시리즈와 같은 높이로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorittsamlinger har nå samme høyde som filmer og serier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriete collecties hebben nu dezelfde hoogte als films en series."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulubione kolekcje mają teraz tę samą wysokość co filmy i seriale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coleções favoritas agora ficam na mesma altura que filmes e séries."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções favoritas agora ficam à mesma altura que filmes e séries."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colecțiile favorite au acum aceeași înălțime ca filmele și serialele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избранные коллекции теперь отображаются той же высоты, что фильмы и сериалы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obľúbené kolekcie sú teraz rovnako vysoké ako filmy a seriály."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritsamlingar har nu samma höjd som filmer och serier."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favori koleksiyonlar artık filmler ve dizilerle aynı yükseklikte görünüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улюблені колекції тепер мають таку саму висоту, як фільми та серіали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收藏的合集现在与电影和剧集保持相同的高度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收藏的合集現在與電影和劇集保持相同的高度。"
          }
        }
      }
    },
