    "settings.cloudSync.status.accountChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastaveno: přihlásil se jiný účet iCloud. Zapni synchronizaci znovu, aby fungovala s tímto účtem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat på pause: en anden iCloud-konto er logget ind. Slå synkronisering til igen for at bruge den med denne konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert: Es hat sich ein anderer iCloud-Account angemeldet. Schalte den Sync wieder ein, um ihn mit diesem Account zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε παύση: συνδέθηκε άλλος λογαριασμός iCloud. Ενεργοποίησε ξανά τον συγχρονισμό για να τον χρησιμοποιήσεις με αυτόν τον λογαριασμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused: a different iCloud account signed in. Turn sync back on to use it with this account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: se inició sesión con otra cuenta de iCloud. Vuelve a activar la sincronización para usarla con esta cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeytetty: laitteeseen kirjautui toinen iCloud-tili. Ota synkronointi uudelleen käyttöön, jotta se toimii tällä tilillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause : un autre compte iCloud s'est connecté. Réactive la synchronisation pour l'utiliser avec ce compte."
