    "settings.playback.subtitle.position.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunout titulky nahoru nebo dolů oproti výchozí poloze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt undertekster op eller ned i forhold til standardpositionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel relativ zur Standardposition nach oben oder unten verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε τους υπότιτλους πάνω ή κάτω σε σχέση με την προεπιλεγμένη θέση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift subtitles up or down from the default position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los subtítulos hacia arriba o hacia abajo respecto a la posición predeterminada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä tekstityksiä ylös- tai alaspäin oletussijaintiin nähden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décaler les sous-titres vers le haut ou vers le bas par rapport à la position par défaut."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomakni titlove gore ili dolje u odnosu na zadanu poziciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feliratok mozgatása felfelé vagy lefelé az alapértelmezett pozícióhoz képest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta i sottotitoli in alto o in basso rispetto alla posizione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕をデフォルト位置から上下に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 위치를 기준으로 자막을 위 또는 아래로 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt undertekster opp eller ned i forhold til standardposisjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats ondertitels omhoog of omlaag ten opzichte van de standaardpositie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń napisy w górę lub w dół względem pozycji domyślnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover legendas para cima ou para baixo em relação à posição padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover legendas para cima ou para baixo em relação à posição padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută subtitrările în sus sau în jos față de poziția implicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
