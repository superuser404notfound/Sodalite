    "changelog.0_5_0.errorCategories.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problémy s připojením, chyby přihlášení, časové limity a 404 mají vlastní ikonu a nadpis místo obecné zprávy „přehrávání selhalo\"."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsesproblemer, login-fejl, timeouts og 404'ere får hver sit ikon og overskrift i stedet for en generisk \"afspilning mislykkedes\"-besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsprobleme, Anmeldefehler, Zeitüberschreitungen und 404er bekommen je ein eigenes Icon und eine passende Überschrift statt einer allgemeinen \"Wiedergabe fehlgeschlagen\"-Meldung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προβλήματα σύνδεσης, τα σφάλματα σύνδεσης, τα χρονικά όρια και τα 404 έχουν το καθένα δικό του εικονίδιο και τίτλο αντί για ένα γενικό μήνυμα «η αναπαραγωγή απέτυχε»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection issues, sign-in problems, timeouts and 404s each get their own icon and headline instead of a generic 'playback failed' message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los problemas de conexión, los errores de inicio de sesión, los tiempos de espera y los 404 reciben cada uno su propio icono y título en lugar de un mensaje genérico de \"fallo de reproducción\"."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteysongelmat, kirjautumisvirheet, aikakatkaisut ja 404-virheet saavat kukin oman kuvakkeensa ja otsikkonsa yleisen \"toisto epäonnistui\"-viestin sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les problèmes de connexion, d'authentification, les délais d'attente et les 404 ont chacun leur propre icône et leur propre titre au lieu d'un message générique \"échec de la lecture\"."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemi s vezom, pogreške prijave, isteci vremena i 404 svaki dobivaju vlastitu ikonu i naslov umjesto općenite poruke \"reprodukcija nije uspjela\"."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolódási problémák, bejelentkezési hibák, időtúllépések és 404-esek mindegyike saját ikont és címet kap az általános \"a lejátszás sikertelen\" üzenet helyett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemi di connessione, errori di accesso, timeout e 404 ottengono ciascuno la propria icona e il proprio titolo invece di un generico messaggio \"riproduzione non riuscita\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続の問題、サインインエラー、タイムアウト、404にそれぞれ専用のアイコンと見出しを表示し、汎用的な「再生に失敗しました」表示を置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 문제, 로그인 오류, 타임아웃, 404 각각이 일반적인 \"재생 실패\" 메시지 대신 고유한 아이콘과 제목을 가집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingsproblemer, innloggingsfeil, tidsavbrudd og 404-er får hver sin ikon og overskrift i stedet for en generisk \"avspilling mislyktes\"-melding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindingsproblemen, aanmeldfouten, time-outs en 404's krijgen elk een eigen pictogram en kop in plaats van een generieke 'afspelen mislukt'-melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemy z połączeniem, błędy logowania, przekroczenia limitu czasu i 404 mają teraz własną ikonę i nagłówek zamiast ogólnego komunikatu „odtwarzanie nieudane\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemas de conexão, erros de login, timeouts e 404s recebem cada um seu próprio ícone e título em vez de uma mensagem genérica de \"falha na reprodução\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemas de ligação, erros de início de sessão, timeouts e 404 recebem cada um o seu próprio ícone e título em vez de uma mensagem genérica de \"reprodução falhou\"."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemele de conexiune, erorile de autentificare, timeout-urile și 404-urile primesc fiecare propria pictogramă și titlu în locul unui mesaj generic \"redare eșuată\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проблемы соединения, ошибки входа, тайм-ауты и 404-е получают собственную иконку и заголовок вместо общего сообщения «воспроизведение не удалось»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problémy s pripojením, chyby prihlásenia, časové limity a 404 majú vlastnú ikonu a nadpis namiesto všeobecnej správy „prehrávanie zlyhalo\"."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningsproblem, inloggningsfel, timeouts och 404:or får var sin ikon och rubrik istället för ett generiskt \"uppspelning misslyckades\"-meddelande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı sorunları, oturum açma hataları, zaman aşımları ve 404'ler genel \"oynatma başarısız\" mesajı yerine her biri kendi simgesini ve başlığını alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проблеми зі з'єднанням, помилки входу, тайм-аути та 404 отримують власну іконку й заголовок замість загального повідомлення «не вдалося відтворити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接问题、登录问题、超时和 404 错误现在各自有专属图标和标题,而不是通用的“播放失败”消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線問題、登入問題、逾時和 404 錯誤現在各自有專屬圖示和標題,而非通用的「播放失敗」訊息。"
          }
        }
      }
    },
