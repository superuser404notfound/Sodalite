    "changelog.0_4_1.polishFixes.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robustnější načítání titulků u 4K souborů, čitelné tlačítka s vlastní akcentní barvou, automatické titulky při přepínání zvuku a další úpravy fokusu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere robust undertekstindlæsning på store 4K-containere, læsbare tonede knapper, auto-undertekster ved manuelt lydskifte og diverse fokus-rettelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robusteres Laden von Untertiteln bei großen 4K-Containern, lesbare Akzent-Buttons, automatische Untertitel beim Audio-Wechsel und diverse Focus-Fixes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιο ανθεκτική φόρτωση υποτίτλων σε μεγάλα 4K αρχεία, ευανάγνωστα κουμπιά με χρώμα έμφασης, αυτόματοι υπότιτλοι σε αλλαγή ήχου, και διορθώσεις εστίασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle loading more resilient on big 4K containers, accent-tint buttons readable, auto-subs fire on manual audio switch, plus various focus fixes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga de subtítulos más resistente en archivos 4K grandes, botones con color de acento legibles, auto-subs al cambiar audio y varios arreglos de foco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstitysten lataus kestävämpi suurissa 4K-tiedostoissa, korostusväriset painikkeet luettavissa, auto-tekstitykset toimivat manuaalisessa äänenvaihdossa ja erilaisia kohdistuskorjauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargement de sous-titres plus robuste sur les gros conteneurs 4K, boutons accent-teintés lisibles, auto-sous-titres au changement audio manuel, et divers correctifs de focus."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otpornije učitavanje titlova na velikim 4K spremnicima, čitljivi gumbi s naglašenom bojom, automatski titlovi pri ručnoj promjeni zvuka, i razne ispravke fokusa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitartóbb felirat-betöltés nagy 4K fájlokon, olvasható kiemelőszínű gombok, automatikus feliratok kézi hangváltáskor és különféle fókusz-javítások."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricamento sottotitoli più robusto su grandi contenitori 4K, pulsanti con colore accento leggibili, auto-sub al cambio audio manuale e varie correzioni di focus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな4Kコンテナでの字幕読み込みがより堅牢に、アクセント色のボタンが読みやすく、手動オーディオ切替時の自動字幕、その他フォーカス修正。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 4K 컨테이너에서 자막 로딩이 더 견고해지고, 강조색 버튼이 읽기 쉬워지며, 수동 오디오 전환 시 자동 자막이 작동하고, 다양한 포커스 수정."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer robust tekstingsinnlasting på store 4K-containere, lesbare aksent-knapper, auto-tekst ved manuelt lydskifte og diverse fokus-rettelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robuustere ondertitelladen bij grote 4K-bestanden, leesbare accent-knoppen, auto-ondertitels bij handmatige audio-wissel, plus diverse focusfixes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wytrwalsze ładowanie napisów dla dużych plików 4K, czytelne przyciski w kolorze akcentu, automatyczne napisy przy ręcznej zmianie ścieżki audio, oraz różne poprawki fokusu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregamento de legendas mais resiliente em arquivos 4K grandes, botões coloridos legíveis, auto-legendas ao trocar áudio manualmente, e várias correções de foco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregamento de legendas mais resiliente em ficheiros 4K grandes, botões com cor de destaque legíveis, auto-legendas ao mudar áudio manualmente, e várias correções de foco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încărcare mai robustă a subtitrărilor pe containere 4K mari, butoane cu nuanță accent lizibile, sub-uri automate la schimbarea audio manuală, și diverse corecturi de focus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более устойчивая загрузка субтитров для больших 4K-файлов, читаемые кнопки с акцентным цветом, авто-субтитры при ручном переключении звука и разные правки фокуса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odolnejšie načítanie titulkov pri veľkých 4K súboroch, čitateľné tlačidlá s akcentovou farbou, automatické titulky pri ručnej zmene zvuku, a rôzne opravy fokusu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer robust undertextladdning på stora 4K-filer, läsbara accentfärgade knappar, auto-undertext vid manuellt ljudbyte och diverse fokusfixar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük 4K dosyalarında daha dayanıklı altyazı yüklemesi, vurgu rengi okunabilir düğmeler, manuel ses değiştirmede otomatik altyazılar ve çeşitli odak düzeltmeleri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стійкіше завантаження субтитрів для великих 4K-файлів, читабельні кнопки з кольором акценту, автосубтитри при ручному перемиканні звуку, та різні правки фокусу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大型 4K 文件上字幕加载更稳健,强调色按钮恢复可读,手动切换音轨时自动启用字幕,以及多项焦点修复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大型 4K 檔案上字幕載入更穩健,強調色按鈕恢復可讀,手動切換音軌時自動啟用字幕,以及多項焦點修復。"
          }
        }
      }
    },
