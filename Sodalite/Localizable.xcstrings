    "settings.seerr.passwordNeededNote" : {
      "comment" : "Shown when the Jellyfin-credentials toggle is on but no Jellyfin password is cached, whatever the reason",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite nemá uložené tvé heslo k Jellyfinu. Zadej ho jednou, aby ses přihlásil k Seerr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite har ikke gemt din Jellyfin-adgangskode. Indtast den én gang for at logge ind på Seerr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite hat dein Jellyfin-Passwort nicht gespeichert. Gib es einmal ein, um dich bei Seerr anzumelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sodalite δεν έχει αποθηκευμένο τον κωδικό σου για το Jellyfin. Δώσ' τον μία φορά για να συνδεθείς στο Seerr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite doesn't have your Jellyfin password saved. Enter it once to sign in to Seerr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite no tiene guardada tu contraseña de Jellyfin. Introdúcela una vez para iniciar sesión en Seerr."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite ei ole tallentanut Jellyfin-salasanaasi. Anna se kerran, niin kirjaudut Seerriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodalite n'a pas enregistré ton mot de passe Jellyfin. Saisis-le une fois pour te connecter à Seerr."
          }
        },
        "hr" : {
