    "changelog.1_0_0.everyScreen.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větší řádky kolekcí, chytřejší výběr profilu, bohatší detaily živé TV a hlubší síťová vyrovnávací paměť, vyladěné na Apple TV, iPhonu a iPadu ve 26 jazycích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større samlingsrækker, en smartere profilvælger, flere live-tv-detaljer og en dybere netværksbuffer, finpudset på Apple TV, iPhone og iPad på 26 sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größere Sammlungszeilen, ein klügerer Profil-Picker, mehr Live-TV-Details und ein tieferer Netzwerkpuffer, feingeschliffen auf Apple TV, iPhone und iPad in 26 Sprachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγαλύτερες σειρές συλλογών, εξυπνότερος επιλογέας προφίλ, πλουσιότερες λεπτομέρειες ζωντανής τηλεόρασης και βαθύτερο buffer δικτύου, σε Apple TV, iPhone και iPad σε 26 γλώσσες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigger collection rows, a smarter profile picker, richer live TV details and a deeper network buffer, polished across Apple TV, iPhone and iPad in 26 languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filas de colecciones más grandes, un selector de perfiles más inteligente, más detalles de TV en directo y un búfer de red más profundo, pulido en Apple TV, iPhone y iPad en 26 idiomas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isommat kokoelmarivit, fiksumpi profiilivalitsin, runsaammat suoran TV:n tiedot ja syvempi verkkopuskuri, viimeistelty Apple TV:llä, iPhonella ja iPadilla 26 kielellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rangées de collections plus grandes, un sélecteur de profil plus malin, des détails TV en direct plus riches et un tampon réseau plus profond, peaufinés sur Apple TV, iPhone et iPad en 26 langues."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veći redovi zbirki, pametniji odabir profila, bogatiji detalji TV-a uživo i dublji mrežni međuspremnik, dotjerano na Apple TV-u, iPhoneu i iPadu na 26 jezika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyobb gyűjteménysorok, okosabb profilválasztó, részletesebb élő TV-adatok és mélyebb hálózati puffer, csiszolva Apple TV-n, iPhone-on és iPaden 26 nyelven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Righe delle raccolte più grandi, un selettore profili più intelligente, dettagli della TV in diretta più ricchi e un buffer di rete più profondo, rifiniti su Apple TV, iPhone e iPad in 26 lingue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクション行の拡大、賢くなったプロファイル選択、より詳しいライブTV情報、より深いネットワークバッファ。Apple TV、iPhone、iPadで26言語に磨き上げました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 큰 컬렉션 행, 더 똑똑한 프로필 선택, 더 풍부한 실시간 TV 정보, 더 깊은 네트워크 버퍼. Apple TV, iPhone, iPad에서 26개 언어로 다듬었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større samlingsrader, en smartere profilvelger, rikere direkte-TV-detaljer og en dypere nettverksbuffer, finpusset på Apple TV, iPhone og iPad på 26 språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotere collectierijen, een slimmere profielkiezer, rijkere live-tv-details en een diepere netwerkbuffer, verfijnd op Apple TV, iPhone en iPad in 26 talen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większe wiersze kolekcji, sprytniejszy wybór profilu, bogatsze szczegóły TV na żywo i głębszy bufor sieciowy, dopracowane na Apple TV, iPhonie i iPadzie w 26 językach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas de coleção maiores, um seletor de perfis mais esperto, mais detalhes de TV ao vivo e um buffer de rede mais profundo, refinados na Apple TV, iPhone e iPad em 26 idiomas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas de coleções maiores, um seletor de perfis mais inteligente, mais detalhes de TV em direto e um buffer de rede mais profundo, refinados na Apple TV, iPhone e iPad em 26 idiomas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rânduri de colecții mai mari, un selector de profil mai inteligent, detalii mai bogate pentru TV live și un buffer de rețea mai adânc, șlefuite pe Apple TV, iPhone și iPad în 26 de limbi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более крупные строки коллекций, умнее выбор профиля, подробнее данные эфирного ТВ и глубже сетевой буфер, отшлифовано на Apple TV, iPhone и iPad на 26 языках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väčšie riadky zbierok, šikovnejší výber profilu, bohatšie detaily živej TV a hlbšia sieťová vyrovnávacia pamäť, vyladené na Apple TV, iPhone a iPade v 26 jazykoch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Större samlingsrader, en smartare profilväljare, rikare live-tv-detaljer och en djupare nätverksbuffert, finslipat på Apple TV, iPhone och iPad på 26 språk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha büyük koleksiyon satırları, daha akıllı bir profil seçici, daha zengin canlı TV ayrıntıları ve daha derin bir ağ arabelleği; Apple TV, iPhone ve iPad'de 26 dilde cilalandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більші рядки колекцій, розумніший вибір профілю, докладніші дані ефірного ТБ і глибший мережевий буфер, відшліфовано на Apple TV, iPhone та iPad 26 мовами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更大的合集行、更聪明的资料选择、更丰富的直播电视信息，以及更深的网络缓冲。在 Apple TV、iPhone 和 iPad 上以 26 种语言精心打磨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更大的合集列、更聰明的個人檔案選擇、更豐富的直播電視資訊，以及更深的網路緩衝。在 Apple TV、iPhone 和 iPad 上以 26 種語言精心打磨。"
          }
        }
      }
    },
