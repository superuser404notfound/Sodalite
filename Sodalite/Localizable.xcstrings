    "settings.logout.confirm.message" : {
      "comment" : "Body of the confirmation alert raised by the Sign Out button",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny servery, profily a uložená přihlášení v tomto zařízení budou odstraněny. Nastavení zůstane zachováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servere, profiler og gemte logins på denne enhed fjernes. Indstillingerne bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Server, Profile und gespeicherten Anmeldungen auf diesem Gerät werden entfernt. Die Einstellungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι οι διακομιστές, τα προφίλ και οι αποθηκευμένες συνδέσεις σε αυτήν τη συσκευή θα αφαιρεθούν. Οι ρυθμίσεις διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every server, profile and saved login on this device is removed. Settings are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los servidores, perfiles e inicios de sesión guardados de este dispositivo. Los ajustes se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tämän laitteen palvelimet, profiilit ja tallennetut kirjautumiset poistetaan. Asetukset säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les serveurs, profils et identifiants enregistrés sur cet appareil sont supprimés. Les réglages sont conservés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi poslužitelji, profili i spremljene prijave na ovom uređaju bit će uklonjeni. Postavke ostaju sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközön lévő összes kiszolgáló, profil és mentett bejelentkezés törlődik. A beállítások megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i server, i profili e gli accessi salvati su questo dispositivo vengono rimossi. Le impostazioni vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上のすべてのサーバ、プロファイル、保存されたログイン情報が削除されます。設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 모든 서버, 프로필, 저장된 로그인 정보가 삭제됩니다. 설정은 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servere, profiler og lagrede innlogginger på denne enheten fjernes. Innstillingene beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle servers, profielen en opgeslagen aanmeldingen op dit apparaat worden verwijderd. De instellingen blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie serwery, profile i zapisane dane logowania na tym urządzeniu zostaną usunięte. Ustawienia zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os servidores, perfis e logins salvos deste dispositivo são removidos. Os ajustes são mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os servidores, perfis e inícios de sessão guardados neste dispositivo são removidos. As definições são mantidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate serverele, profilurile și datele de conectare salvate de pe acest dispozitiv sunt eliminate. Setările sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все серверы, профили и сохранённые входы на этом устройстве будут удалены. Настройки сохранятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky servery, profily a uložené prihlásenia v tomto zariadení sa odstránia. Nastavenia zostanú zachované."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla servrar, profiler och sparade inloggningar på den här enheten tas bort. Inställningarna behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdaki tüm sunucular, profiller ve kayıtlı oturum açma bilgileri kaldırılır. Ayarlar korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі сервери, профілі та збережені входи на цьому пристрої буде вилучено. Налаштування збережуться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本设备上的所有服务器、配置文件和已保存的登录信息都会被移除。设置将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本裝置上的所有伺服器、設定檔和已儲存的登入資訊都會被移除。設定將保留。"
          }
        }
      }
    },
